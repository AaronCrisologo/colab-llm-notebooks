., \"What date...\", \"Who was...\").\n","    2. Focus on \"Why\", \"How\", \"Consequences\", and \"Human Experience\".\n","    3. Make the questions sound like a curious university student asking a professor.\n","\n","    Example of BAD: \"When was the Katipunan founded?\"\n","    Example of GOOD: \"How did the secrecy of the Katipunan affect its recruitment in the early days?\"\n","\n","    Avoid themes: [{memory_buffer}]\n","    Return ONLY JSON list: [{{\"question\": \"...\"}}]\n","    \"\"\"\n","\n","    for attempt in range(max_retries):\n","        try:\n","            print(f\"  Attempt {attempt + 1}/{max_retries}...\")\n","\n","            with timeout(timeout_seconds):\n","                raw_output = call_glm_with_retry(prompt, \"You are a historical researcher.\", temperature=0.7)\n","\n","            if not raw_output:\n","                print(f\"  ⚠️ Empty response on attempt {attempt + 1}\")\n","                continue\n","\n","            parsed = json.loads(clean_json_output(raw_output))\n","            questions = [item['question'] for item in parsed]\n","\n","            if len(questions) == 5:  # Validate we got 5 questions\n","                global_seen_questions.extend(questions)\n","                print(f\"  ✅ Generated {len(questions)} questions\")\n","                return questions\n","            else:\n","                print(f\"  ⚠️ Got {len(questions)} questions instead of 5\")\n","\n","        except TimeoutError as e:\n","            print(f\"  ⏱️ Timeout on attempt {attempt + 1}: {e}\")\n","            time.sleep(2 ** attempt)  # Exponential backoff\n","        except json.JSONDecodeError as e:\n","            print(f\"  ⚠️ JSON error on attempt {attempt + 1}: {e}\")\n","            time.sleep(2)\n","        except Exception as e:\n","            print(f\"  ⚠️ Error on attempt {attempt + 1}: {e}\")\n","            time.sleep(2)\n","\n","    print(f\"  ❌ Failed after {max_retries} attempts\")\n","    return []\n","\n","def translate_and_answer_batch(questions, topic, language, max_retries=5, timeout_seconds=90):\n","    \"\"\"Processes all questions for a topic in ONE API call (High Token Efficiency).\"\"\"\n","    print(f\"🌍 Batching {len(questions)} questions for {language}...\")\n","\n","    # Format questions with clear numbering\n","    formatted_qs = \"\\n\".join([f\"{i+1}. {q}\" for i, q in enumerate(questions)])\n","\n","    # Dynamic System Prompt based on Language\n","    tone_instruction = \"\"\n","    if language == \"Tagalog\":\n","        tone_instruction = \"Use natural, conversational Filipino. Avoid deep/archaic Tagalog (Malalim na Tagalog). Use 'Taglish' only for modern technical terms if necessary, but prefer natural phrasing.\"\n","    elif language == \"Cebuano\":\n","        tone_instruction = \"Use natural Cebuano Bisaya as spoken in everyday conversation. Avoid mixing with Hiligaynon/Waray. Use particles (ba, diay, man, lagi) to sound authentic.\"\n","    elif language == \"Ilocano\":\n","        tone_instruction = \"Use standard but natural Ilocano. Ensure proper use of honorifics/particles where applicable to sound respectful yet conversational.\"\n","\n","    prompt = f\"\"\"\n","    Topic: {topic}\n","    Target Language: {language}\n","\n","    Questions to Process:\n","    {formatted_qs}\n","\n","    TASK:\n","    For each question above, you must:\n","    1. Translate the question into {language}. Make it sound like a native speaker asking.\n","    2. Answer the question in {language} (3-5 sentences).\n","\n","    CRITICAL TONE GUIDE:\n","    - {tone_instruction}\n","    - Do NOT sound like a robot or a textbook. Sound like a knowledgeable local historian explaining to a friend.\n","    - Focus on storytelling, not just listing facts.\n","\n","    REQUIRED OUTPUT FORMAT:\n","    Return EXACTLY {len(questions)} items in a JSON array.\n","    Each item must have:\n","    - \"id\": Use the question number from above (1, 2, 3, 4, 5)\n","    - \"translated_question\": The translated question\n","    - \"answer\": The answer in {language}\n","\n","    Example Structure:\n","    [\n","        {{\"id\": 1, \"translated_question\": \"...\", \"answer\": \"...\"}},\n","        {{\"id\": 2, \"translated_question\": \"...\", \"answer\": \"...\"}},\n","        {{\"id\": 3, \"translated_question\": \"...\", \"answer\": \"...\"}},\n","        {{\"id\": 4, \"translated_question\": \"...\", \"answer\": \"...\"}},\n","        {{\"id\": 5, \"translated_question\": \"...\", \"answer\": \"...\"}}\n","    ]\n","\n","    Return ONLY the JSON array, no additional text.\n","    \"\"\"\n","\n","    sys_msg = f\"Expert historian and {language} translator. Return valid JSON only.\"\n","\n","    for attempt in range(max_retries):\n","        try:\n","            print(f\"  Attempt {attempt + 1}/{max_retries}...\")\n","\n","            # Use timeout to prevent hanging\n","            with timeout(timeout_seconds):\n","                raw_output = call_glm_with_retry(prompt, system_prompt=sys_msg, temperature=0.2)\n","\n","            if not raw_output:\n","                print(f\"  ⚠️ Empty response on attempt {attempt + 1}/{max_retries}\")\n","                time.sleep(2 ** attempt)  # Exponential backoff\n","                continue\n","\n","            cleaned = clean_json_output(raw_output)\n","            parsed = json.loads(cleaned)\n","\n","            # Validate it's a list\n","            if not isinstance(parsed, list):\n","                print(f\"  ⚠️ Response is not a list on attempt {attempt + 1}/{max_retries}\")\n","                time.sleep(2)\n","                continue\n","\n","            # Validate we got the right number of items\n","            if len(parsed) != len(questions):\n","                print(f\"  ⚠️ Expected {len(questions)} items, got {len(parsed)} on attempt {attempt + 1}/{max_retries}\")\n","                time.sleep(2)\n","                continue\n","\n","            # Validate each item has required fields\n","            valid_batch = True\n","            for item in parsed:\n","                if not all(key in item for key in ['id', 'translated_question', 'answer']):\n","                    print(f\"  ⚠️ Missing required fields in item on attempt {attempt + 1}/{max_retries}\")\n","                    valid_batch = False\n","                    break\n","                # Check for empty values\n","                if not item.get('translated_question', '').strip() or not item.get('answer', '').strip():\n","                    print(f\"  ⚠️ Empty question or answer in item on attempt {attempt + 1}/{max_retries}\")\n","                    valid_batch = False\n","                    break\n","\n","            if valid_batch:\n","                print(f\"  ✅ Successfully processed batch\")\n","                return parsed\n","            else:\n","                time.sleep(2)\n","\n","        except TimeoutError as e:\n","            print(f\"  ⏱️ Timeout on attempt {attempt + 1}/{max_retries}: {e}\")\n","            time.sleep(2 ** attempt)  # Exponential backoff\n","        except json.JSONDecodeError as e:\n","            print(f\"  ⚠️ JSON decode error on attempt {attempt + 1}/{max_retries}: {str(e)[:100]}\")\n","            time.sleep(2)\n","        except Exception as e:\n","            print(f\"  ⚠️ Unexpected error on attempt {attempt + 1}/{max_retries}: {str(e)[:100]}\")\n","            time.sleep(2)\n","\n","    print(f\"  ❌ Failed to get valid batch for topic '{topic}' after {max_retries} attempts\")\n","    return []\n","\n","# --- MAIN EXECUTION ---\n","# Ensure the DRIVE_PATH exists from the kernel state\n","DRIVE_PATH = '/content/drive/MyDrive/PhHistoryDataset-ceb' # Defined in kernel state\n","\n","LANGUAGES = [\"Cebuano\"]\n","# LANGUAGES = [\"Tagalog\", \"Cebuano\", \"Ilocano\"]\n","MASTER_QUESTIONS_FILE = os.path.join(DRIVE_PATH, \"master_questions.json\")\n","DATASET_FILE_PREFIX = os.path.join(DRIVE_PATH, \"ph_history_ceb\")\n","\n","# Configuration\n","QUESTION_TIMEOUT = 60  # seconds for question generation\n","BATCH_TIMEOUT = 120    # seconds for batch translation/answering\n","MAX_RETRIES = 5\n","\n","if os.path.exists(TOPICS_FILE):\n","    with open(TOPICS_FILE, \"r\") as f:\n","        all_topics = json.load(f)\n","        # Only take rows 1-267 (indices 0-266)\n","        topics_to_process = all_topics[342:609]\n","\n","    # STEP 1: Generate & Save Master English Questions\n","    global_seen_english_questions = []\n","    questions_map = {}\n","    failed_topics = []\n","\n","    print(f\"\\n{'='*70}\")\n","    print(f\"🚀 Phase 1: Generating Master English Questions...\")\n","    print(f\"   Timeout per topic: {QUESTION_TIMEOUT}s\")\n","    print(f\"   Max retries: {MAX_RETRIES}\")\n","    print(f\"{'='*70}\\n\")\n","\n","    for idx, topic in enumerate(topics_to_process, 1):\n","        print(f\"\\n[{idx}/{len(topics_to_process)}] Topic: {topic[:60]}...\")\n","\n","        qs = generate_english_questions_for_topic(\n","            topic,\n","            global_seen_english_questions,\n","            max_retries=MAX_RETRIES,\n","            timeout_seconds=QUESTION_TIMEOUT\n","        )\n","\n","        if qs and len(qs) == 5:\n","            questions_map[topic] = qs\n","            print(f\"✅ Generated {len(qs)} questions\")\n","        else:\n","            failed_topics.append(topic)\n","            print(f\"❌ Failed to generate questions\")\n","\n","        time.sleep(0.5)\n","\n","    # Save to separate file\n","    with open(MASTER_QUESTIONS_FILE, \"w\", encoding=\"utf-8\") as mq_file:\n","        json.dump(questions_map, mq_file, indent=4, ensure_ascii=False)\n","\n","    # # Load existing questions from your local file instead of generating them\n","    # if os.path.exists(MASTER_QUESTIONS_FILE):\n","    #     print(f\"📂 Loading existing questions from {MASTER_QUESTIONS_FILE}...\")\n","    #     with open(MASTER_QUESTIONS_FILE, \"r\", encoding=\"utf-8\") as mq_file:\n","    #         questi