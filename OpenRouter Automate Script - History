{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"1-mxXYNoUTmkMOmp9imJ6mVridArhs6Of","timestamp":1770505959689}],"mount_file_id":"1kcayzwSimg77--hJWVlzt0ddW7u69u6T","authorship_tag":"ABX9TyP5h3mkYf1oHTfuhU1j9ZgZ"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":["# Setup and Utilities\n","\n","This cell handles imports, API configuration, and the shared helper functions.\n","\n","\n","\n","\n"],"metadata":{"id":"vhJuF3GGhNFj"}},{"cell_type":"code","source":["import os\n","import re\n","import json\n","import time\n","import requests\n","from google.colab import userdata\n","\n","# --- CONFIGURATION ---\n","OPENROUTER_API_KEY = userdata.get('OPENROUTER_API_KEY')\n","MODEL_NAME = \"qwen/qwen3-235b-a22b-2507\"\n","TOPICS_FILE = \"topics_list.json\"\n","DATASET_FILE = \"ph_history_dataset.jsonl\"\n","\n","def call_glm_with_retry(prompt, system_prompt=\"You are an expert historian.\", max_retries=20, temperature=0.7):\n","    delay = 2\n","    for i in range(max_retries):\n","        try:\n","            response = requests.post(\n","                url=\"https://openrouter.ai/api/v1/chat/completions\",\n","                headers={\n","                    \"Authorization\": f\"Bearer {OPENROUTER_API_KEY}\",\n","                    \"Content-Type\": \"application/json\",\n","                },\n","                data=json.dumps({\n","                    \"model\": MODEL_NAME,\n","                    \"temperature\": temperature,\n","                    \"messages\": [\n","                        {\"role\": \"system\", \"content\": system_prompt},\n","                        {\"role\": \"user\", \"content\": prompt}\n","                    ],\n","                    \"provider\": {\n","                      # Order: 1st DeepInfra, 2nd Novita, 3rd SiliconFlow\n","                      \"order\": [\"wandb\", \"DeepInfra\", \"Novita\", \"SiliconFlow\"],\n","                      \"quantizations\": [\"bf16\", \"fp8\"],\n","                      \"allow_fallbacks\": True\n","                    }\n","                })\n","            )\n","            if response.status_code == 200:\n","                return response.json()['choices'][0]['message']['content']\n","            elif response.status_code in [429, 402]:\n","                print(f\"Rate limit/Balance hit ({response.status_code}). Retrying in {delay}s...\")\n","                time.sleep(delay)\n","                delay *= 2\n","            else:\n","                print(f\"API Error {response.status_code}: {response.text}\")\n","                break\n","        except Exception as e:\n","            print(f\"Network Error: {e}\")\n","            time.sleep(delay)\n","            delay *= 2\n","    return None\n","\n","def clean_json_output(raw_output):\n","    if not raw_output: return \"\"\n","    # Remove Markdown code blocks\n","    text = raw_output.replace(\"```json\", \"\").replace(\"```\", \"\").strip()\n","    # Find the first '[' and last ']' to isolate the array\n","    start = text.find(\"[\")\n","    end = text.rfind(\"]\")\n","    if start != -1 and end != -1:\n","        return text[start:end+1]\n","    return text"],"metadata":{"id":"0OlH_jj-hFVm","executionInfo":{"status":"ok","timestamp":1771046610412,"user_tz":-480,"elapsed":1568,"user":{"displayName":"LectorFrostbite","userId":"07900419769422003588"}}},"execution_count":12,"outputs":[]},{"cell_type":"markdown","source":["# Cell 2: Topic Generation\n","Run this once to generate your topics. It saves them to topics_list.json."],"metadata":{"id":"bcwhbhcmhvCk"}},{"cell_type":"code","source":["import json\n","import os\n","import random\n","import time\n","from typing import List, Set, Dict\n","\n","# Add these constants at the top with other configurations\n","EXCLUSION_FILE = \"existing_topics_to_exclude.json\"  # Your existing topics file\n","MASTER_FILE = \"all_topics_master.json\"  # Combined master file\n","BACKUP_DIR = \"topic_backups\"  # Directory for backups\n","\n","# --- THEMATIC LENSES AND FACTUAL ANCHORS (RESTORED) ---\n","THEMATIC_LENSES = [\n","    \"Material Culture (Textiles, Jewelry, Ceramics)\",\n","    \"Environmental History (Volcanoes, Monsoons, Famines)\",\n","    \"Intellectual History (Libraries, Censorship, Printing)\",\n","    \"Maritime History (Shipbuilding, Navigation, Sea Rituals)\",\n","    \"Legal & Administrative History (Audits, Taxation, Local Courts)\",\n","    \"Public Health & Medicine (Epidemics, Shamanic Healing, Pharmacy)\",\n","    \"Subversive Networks (Secret Societies, Ciphers, Smuggling)\",\n","    \"Linguistic History (Baybayin Survival and Hispanicized Dialects)\",\n","    \"Indigenous Resistance (Highland Fugitives and Maritime Defiance)\",\n","    \"Economic Logistics (The Abaca Trade and the Opening of Provincial Ports)\",\n","    \"Religious Syncretism (Folk Catholicism, Anito Worship Integration)\",\n","    \"Gender and Society (Women in Pre-Colonial Trade, Babaylan Roles)\",\n","    \"Agricultural Systems (Rice Terraces, Irrigation, Land Reform)\",\n","    \"Colonial Architecture (Bahay na Bato, Stone Churches, Fortifications)\",\n","    \"Print Culture (Periodicals, Ilustrado Publications, Revolutionary Pamphlets)\",\n","]\n","\n","# FACTUAL ANCHOR POINTS - Real documented topics to guide generation\n","FACTUAL_ANCHORS = {\n","    \"Pre-Colonial Era\": [\n","        \"Laguna Copperplate Inscription\", \"Ma-i polity\", \"Tondo polity\",\n","        \"Butuan balangay boats\", \"Cebu's pre-colonial trade networks\",\n","        \"Sulu Sultanate founding\", \"Maguindanao Sultanate\"\n","    ],\n","    \"Spanish Colonial\": [\n","        \"Battle of Mactan\", \"Legazpi expedition\", \"Manila-Acapulco Galleon Trade\",\n","        \"Dagohoy Rebellion\", \"Silang Revolt\", \"Palaris Revolt\",\n","        \"British occupation of Manila (1762-1764)\", \"Royal Company of the Philippines\",\n","        \"Tobacco Monopoly\", \"Opening of Suez Canal impact\", \"Cavite Mutiny\"\n","    ],\n","    \"19th Century Reform\": [\n","        \"Propaganda Movement\", \"La Solidaridad newspaper\", \"Noli Me Tangere publication\",\n","        \"Execution of GOMBURZA\", \"Katipunan founding\", \"Cry of Pugad Lawin\",\n","        \"Tejeros Convention\", \"Biak-na-Bato Republic\"\n","    ],\n","    \"Revolution & War\": [\n","        \"Battle of Manila Bay\", \"Malolos Congress\", \"Philippine-American War\",\n","        \"Balangiga Massacre\", \"Samar campaign\", \"Macabebe Scouts\"\n","    ],\n","    \"American Period\": [\n","        \"Thomasites\", \"Philippine Assembly\", \"Jones Law\", \"Sakdal Uprising\",\n","        \"Commonwealth establishment\", \"Tydings-McDuffie Act\"\n","    ]\n","}\n","\n","def load_existing_topics() -> List[str]:\n","    \"\"\"Load existing topics from multiple sources to exclude them.\"\"\"\n","    existing_topics = []\n","\n","    # 1. Load from current file (if any)\n","    if os.path.exists(TOPICS_FILE):\n","        try:\n","            with open(TOPICS_FILE, \"r\", encoding=\"utf-8\") as f:\n","                content = f.read()\n","                if content:\n","                    existing_topics.extend(json.loads(content))\n","                    print(f\"📁 Loaded {len(json.loads(content))} topics from current file\")\n","        except (json.JSONDecodeError, IOError) as e:\n","            print(f\"⚠️  Error loading current topics: {e}\")\n","\n","    # 2. Load from exclusion file (your existing topics)\n","    if os.path.exists(EXCLUSION_FILE):\n","        try:\n","            with open(EXCLUSION_FILE, \"r\", encoding=\"utf-8\") as f:\n","                content = f.read()\n","                if content:\n","                    excluded = json.loads(content)\n","                    existing_topics.extend(excluded)\n","                    print(f\"📁 Loaded {len(excluded)} topics from exclusion file\")\n","        except (json.JSONDecodeError, IOError) as e:\n","            print(f\"⚠️  Error loading exclusion topics: {e}\")\n","\n","    # Remove duplicates while preserving order\n","    seen = set()\n","    deduped = []\n","    for topic in existing_topics:\n","        if topic not in seen:\n","            seen.add(topic)\n","            deduped.append(topic)\n","\n","    print(f\"📚 Total existing topics (including exclusion): {len(deduped)}\")\n","    return deduped\n","\n","def save_topics(topics: List[str]):\n","    \"\"\"Save topics to JSON file.\"\"\"\n","    with open(TOPICS_FILE, \"w\", encoding=\"utf-8\") as f:\n","        json.dump(topics, f, indent=4, ensure_ascii=False)\n","\n","def extract_core_entities(topics: List[str]) -> Set[str]:\n","    \"\"\"Extract key entities/subjects from existing topics to avoid repetition.\"\"\"\n","    entities = set()\n","    common_words = {\"the\", \"of\", \"and\", \"in\", \"a\", \"an\", \"to\", \"from\", \"era\", \"period\"}\n","\n","    for topic in topics:\n","        # Extract meaningful words (simple approach)\n","        words = topic.lower().replace(\":\", \" \").replace(\"-\", \" \").split()\n","        meaningful_words = [w for w in words if len(w) > 4 and w not in common_words]\n","        entities.update(meaningful_words[:3])  # First 3 meaningful words\n","\n","    return entities\n","\n","def create_anti_hallucination_prompt(\n","    count: int,\n","    lens: str,\n","    existing_topics: List[str],\n","    used_entities: Set[str],\n","    batch_number: int\n",") -> str:\n","    \"\"\"Create a prompt with strong anti-hallucination guardrails.\"\"\"\n","\n","    # Select random factual anchors from relevant eras\n","    anchor_examples = []\n","    for era, topics in FACTUAL_ANCHORS.items():\n","        anchor_examples.extend(random.sample(topics, min(2, len(topics))))\n","    random.shuffle(anchor_examples)\n","    anchor_str = \", \".join(anchor_examples[:8])\n","\n","    # Create exclusion context\n","    recent_topics = existing_topics[-50:] if len(existing_topics) > 50 else existing_topics\n","    exclusion_sample = json.dumps(recent_topics[:20], ensure_ascii=False)\n","\n","    overused_entities = \", \".join(list(used_entities)[:30])\n","\n","    prompt = f\"\"\"You are a Philippine history scholar with expertise in {lens}.\n","\n","**MISSION**: Generate {count} historically accurate, verifiable topics for Philippine history research.\n","\n","**CRITICAL RULE - ZERO TOLERANCE FOR HALLUCINATION**:\n","- Every topic MUST reference a real, documented historical event, person, or phenomenon\n","- If you're uncertain about ANY detail, DO NOT include it\n","- Cross-reference mentally against known historical facts before suggesting\n","- Examples of REAL events you can build from: {anchor_str}\n","\n","**CURRENT THEMATIC LENS** (Batch #{batch_number}):\n","Focus Area: {lens}\n","\n","**STRUCTURAL REQUIREMENTS**:\n","1. Use format: \"The [Subject]: [Specific Analytical Angle]\"\n","2. AVOID years in titles unless essential (prefer \"Spanish Colonial Era\", \"Post-War Period\")\n","3. Mix these approaches:\n","   - Investigative: logistics, mechanisms, processes\n","   - Biographical: specific historical figures and their contributions\n","   - Anthropological: cultural practices, social structures\n","   - Economic: trade systems, taxation, resources\n","   - Material: artifacts, architecture, technology\n","   - Comparative: regional variations, cross-cultural exchanges\n","\n","**DIVERSITY REQUIREMENTS**:\n","- 40% Well-documented major events (with specific angles)\n","- 30% Regional/local history (Visayas, Mindanao, provincial)\n","- 20% Social/cultural history (daily life, practices, beliefs)\n","- 10% Material/economic history (objects, trade goods, industries)\n","\n","**STRICT EXCLUSIONS**:\n","1. DO NOT repeat or create variations of these recent topics: {exclusion_sample}\n","2. MINIMIZE these overused entities: {overused_entities}\n","3. NEVER invent battles, treaties, or revolts that didn't exist\n","4. AVOID generic titles like \"The History of...\" or \"Overview of...\"\n","\n","**VERIFICATION CHECKLIST** (mentally verify each before including):\n","□ Is this event/person/phenomenon documented in historical records?\n","□ Can I name at least one historical source or context for this?\n","□ Is this distinct from the exclusion list?\n","□ Does this fit the current thematic lens?\n","\n","**OUTPUT FORMAT**:\n","Return ONLY a valid JSON array of strings. Example:\n","[\n","  \"The Tobacco Monopoly: Economic Impact on Ilocos Agriculture\",\n","  \"Dagohoy's Cave Networks: Geographic Strategy in the Bohol Rebellion\"\n","]\n","\n","Generate {count} topics now:\"\"\"\n","\n","    return prompt\n","\n","def validate_topics_for_hallucination(topics: List[str]) -> tuple[List[str], List[str]]:\n","    \"\"\"\n","    Basic validation to catch obvious hallucinations.\n","    Returns: (valid_topics, suspicious_topics)\n","    \"\"\"\n","    valid = []\n","    suspicious = []\n","\n","    # Red flags for potential hallucination\n","    red_flag_patterns = [\n","        \"1907\", \"1908\", \"1909\",  # Random uncommon years\n","        \"Salt March\", \"Rice Revolt\",  # Borrowed from other countries' history\n","        \"Treaty of\", \"Pact of\",  # Often fabricated\n","        \"Secret Alliance\", \"Hidden\",  # Vague, hard to verify\n","    ]\n","\n","    for topic in topics:\n","        is_suspicious = any(flag in topic for flag in red_flag_patterns)\n","\n","        # Additional check: topics that are too vague\n","        if len(topic) < 20 or topic.count(\" \") < 3:\n","            is_suspicious = True\n","\n","        if is_suspicious:\n","            suspicious.append(topic)\n","        else:\n","            valid.append(topic)\n","\n","    return valid, suspicious\n","\n","def check_similarity(new_topic: str, existing_topics: List[str], threshold: float = 0.6) -> bool:\n","    \"\"\"\n","    Simple similarity check using word overlap.\n","    Returns True if topic is too similar to existing ones.\n","    \"\"\"\n","    new_words = set(new_topic.lower().split())\n","\n","    for existing in existing_topics:\n","        existing_words = set(existing.lower().split())\n","\n","        # Jaccard similarity\n","        intersection = len(new_words & existing_words)\n","        union = len(new_words | existing_words)\n","\n","        if union > 0:\n","            similarity = intersection / union\n","            if similarity > threshold:\n","                return True\n","\n","    return False\n","\n","def generate_batch(\n","    batch_size: int,\n","    lens: str,\n","    existing_topics: List[str],\n","    used_entities: Set[str],\n","    batch_number: int\n",") -> List[str]:\n","    \"\"\"Generate a single batch of topics with validation.\"\"\"\n","\n","    prompt = create_anti_hallucination_prompt(\n","        count=batch_size,\n","        lens=lens,\n","        existing_topics=existing_topics,\n","        used_entities=used_entities,\n","        batch_number=batch_number\n","    )\n","\n","    # Call your LLM function here\n","    result = call_glm_with_retry(prompt, \"Fact-Checked Historian\", temperature=0.7)\n","\n","    if not result:\n","        return []\n","\n","    try:\n","        new_topics = json.loads(clean_json_output(result))\n","\n","        # Validate for hallucinations\n","        valid_topics, suspicious_topics = validate_topics_for_hallucination(new_topics)\n","\n","        if suspicious_topics:\n","            print(f\"⚠️  Filtered {len(suspicious_topics)} suspicious topics: {suspicious_topics[:3]}\")\n","\n","        # Deduplicate against existing\n","        unique_topics = []\n","        for topic in valid_topics:\n","            if topic not in existing_topics and not check_similarity(topic, existing_topics):\n","                unique_topics.append(topic)\n","\n","        return unique_topics\n","\n","    except Exception as e:\n","        print(f\"❌ Error parsing batch: {e}\")\n","        return []\n","\n","def create_backup(filepath: str):\n","    \"\"\"Create timestamped backup of a file.\"\"\"\n","    import shutil\n","    from datetime import datetime\n","\n","    if not os.path.exists(BACKUP_DIR):\n","        os.makedirs(BACKUP_DIR)\n","\n","    if os.path.exists(filepath):\n","        timestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n","        filename = os.path.basename(filepath)\n","        backup_path = os.path.join(BACKUP_DIR, f\"{timestamp}_{filename}\")\n","        shutil.copy2(filepath, backup_path)\n","        print(f\"💾 Created backup: {backup_path}\")\n","\n","def combine_and_create_master():\n","    \"\"\"\n","    Combine topics from exclusion file and newly generated file into a master file.\n","    Also creates backups of original files.\n","    \"\"\"\n","    from datetime import datetime\n","\n","    print(f\"\\n{'='*70}\")\n","    print(f\"🔄 Combining topics into master file...\")\n","    print(f\"{'='*70}\")\n","\n","    # Create backups first\n","    if os.path.exists(EXCLUSION_FILE):\n","        create_backup(EXCLUSION_FILE)\n","\n","    if os.path.exists(TOPICS_FILE):\n","        create_backup(TOPICS_FILE)\n","\n","    # Load all topics from both sources\n","    all_topics = []\n","    sources = []\n","\n","    # Load from exclusion file (existing topics)\n","    if os.path.exists(EXCLUSION_FILE):\n","        try:\n","            with open(EXCLUSION_FILE, \"r\", encoding=\"utf-8\") as f:\n","                excluded_topics = json.load(f)\n","                all_topics.extend(excluded_topics)\n","                sources.append((EXCLUSION_FILE, len(excluded_topics)))\n","                print(f\"📁 Added {len(excluded_topics)} topics from {EXCLUSION_FILE}\")\n","        except Exception as e:\n","            print(f\"⚠️  Error loading {EXCLUSION_FILE}: {e}\")\n","\n","    # Load from newly generated topics\n","    if os.path.exists(TOPICS_FILE):\n","        try:\n","            with open(TOPICS_FILE, \"r\", encoding=\"utf-8\") as f:\n","                new_topics = json.load(f)\n","                all_topics.extend(new_topics)\n","                sources.append((TOPICS_FILE, len(new_topics)))\n","                print(f\"📁 Added {len(new_topics)} topics from {TOPICS_FILE}\")\n","        except Exception as e:\n","            print(f\"⚠️  Error loading {TOPICS_FILE}: {e}\")\n","\n","    # Remove duplicates while preserving order of first appearance\n","    seen = set()\n","    unique_topics = []\n","    duplicates_count = 0\n","\n","    for topic in all_topics:\n","        if topic not in seen:\n","            seen.add(topic)\n","            unique_topics.append(topic)\n","        else:\n","            duplicates_count += 1\n","\n","    # Sort topics alphabetically for better organization (optional)\n","    unique_topics.sort()\n","\n","    # Save to master file\n","    try:\n","        with open(MASTER_FILE, \"w\", encoding=\"utf-8\") as f:\n","            json.dump(unique_topics, f, indent=4, ensure_ascii=False)\n","\n","        print(f\"\\n✅ Master file created: {MASTER_FILE}\")\n","        print(f\"📊 Summary:\")\n","        print(f\"   Total topics from all sources: {len(all_topics)}\")\n","        print(f\"   Duplicates removed: {duplicates_count}\")\n","        print(f\"   Unique topics in master file: {len(unique_topics)}\")\n","        print(f\"   Sources combined: {[f'{name} ({count})' for name, count in sources]}\")\n","\n","        # Create metadata about the merge\n","        metadata = {\n","            \"merge_date\": datetime.now().isoformat(),\n","            \"source_files\": [name for name, _ in sources],\n","            \"source_counts\": {name: count for name, count in sources},\n","            \"total_before_deduplication\": len(all_topics),\n","            \"duplicates_removed\": duplicates_count,\n","            \"total_after_deduplication\": len(unique_topics)\n","        }\n","\n","        metadata_file = MASTER_FILE.replace(\".json\", \"_metadata.json\")\n","        with open(metadata_file, \"w\", encoding=\"utf-8\") as f:\n","            json.dump(metadata, f, indent=4, ensure_ascii=False)\n","\n","        print(f\"📋 Metadata saved to: {metadata_file}\")\n","\n","        return unique_topics\n","\n","    except Exception as e:\n","        print(f\"❌ Error creating master file: {e}\")\n","        return []\n","\n","def generate_topics_to_target(target_count: int = 800, batch_size: int = 15):\n","    \"\"\"\n","    Generate topics until reaching target count with strong anti-hallucination measures.\n","    Returns combined master topics after generation.\n","    \"\"\"\n","    print(f\"🎯 Target: {target_count} unique, factual Philippine history topics\")\n","    print(f\"📊 Batch size: {batch_size}\")\n","    print(f\"📁 Exclusion file: {EXCLUSION_FILE}\")\n","    print(f\"📁 Master file: {MASTER_FILE}\")\n","    print(f\"📁 Current topics file: {TOPICS_FILE}\\n\")\n","\n","    existing_topics = load_existing_topics()\n","    print(f\"📚 Starting with {len(existing_topics)} topics to exclude\")\n","\n","    batch_number = 0\n","    failed_attempts = 0\n","    max_failed_attempts = 5\n","\n","    # Calculate how many new topics we need\n","    existing_count = len(existing_topics)\n","    new_target_count = max(0, target_count - existing_count)\n","\n","    if new_target_count == 0:\n","        print(f\"🎉 Already reached target count! {existing_count}/{target_count}\")\n","        print(\"🔄 Proceeding to combine files...\")\n","        return combine_and_create_master()\n","\n","    print(f\"📈 Need to generate {new_target_count} new topics\")\n","\n","    while len(existing_topics) < target_count:\n","        batch_number += 1\n","        remaining = target_count - len(existing_topics)\n","        current_batch_size = min(batch_size, remaining + 5)  # Generate extra for filtering\n","\n","        # Rotate through thematic lenses\n","        lens = THEMATIC_LENSES[batch_number % len(THEMATIC_LENSES)]\n","\n","        # Extract used entities for exclusion\n","        used_entities = extract_core_entities(existing_topics)\n","\n","        print(f\"\\n🔄 Batch {batch_number} | Focus: {lens}\")\n","        print(f\"📈 Progress: {len(existing_topics)}/{target_count} ({len(existing_topics)/target_count*100:.1f}%)\")\n","\n","        # Generate batch\n","        new_topics = generate_batch(\n","            batch_size=current_batch_size,\n","            lens=lens,\n","            existing_topics=existing_topics,\n","            used_entities=used_entities,\n","            batch_number=batch_number\n","        )\n","\n","        if new_topics:\n","            existing_topics.extend(new_topics)\n","            save_topics(existing_topics)\n","            print(f\"✅ Added {len(new_topics)} topics | Total: {len(existing_topics)}\")\n","            failed_attempts = 0\n","        else:\n","            failed_attempts += 1\n","            print(f\"⚠️  No new topics generated (attempt {failed_attempts}/{max_failed_attempts})\")\n","\n","            if failed_attempts >= max_failed_attempts:\n","                print(f\"\\n⚠️  Stopping: {max_failed_attempts} consecutive failed batches\")\n","                break\n","\n","        # Rate limiting\n","        time.sleep(2)\n","\n","    print(f\"\\n{'='*70}\")\n","    print(f\"🎉 GENERATION COMPLETE!\")\n","    print(f\"   Generated {len(existing_topics)} total topics\")\n","    print(f\"   Saved to: {TOPICS_FILE}\")\n","    print(f\"{'='*70}\\n\")\n","\n","    # Combine files and create master file\n","    master_topics = combine_and_create_master()\n","\n","    return master_topics\n","\n","def analyze_topic_overlap():\n","    \"\"\"Analyze overlap between exclusion file and newly generated topics.\"\"\"\n","    if not os.path.exists(EXCLUSION_FILE) or not os.path.exists(TOPICS_FILE):\n","        print(\"❌ Both files must exist for analysis\")\n","        return\n","\n","    with open(EXCLUSION_FILE, \"r\", encoding=\"utf-8\") as f:\n","        excluded_topics = set(json.load(f))\n","\n","    with open(TOPICS_FILE, \"r\", encoding=\"utf-8\") as f:\n","        new_topics = set(json.load(f))\n","\n","    overlap = excluded_topics.intersection(new_topics)\n","\n","    print(f\"\\n{'='*70}\")\n","    print(f\"📊 TOPIC OVERLAP ANALYSIS\")\n","    print(f\"{'='*70}\")\n","    print(f\"Exclusion file topics: {len(excluded_topics)}\")\n","    print(f\"New topics: {len(new_topics)}\")\n","    print(f\"Overlap (duplicates): {len(overlap)}\")\n","    print(f\"Unique new topics: {len(new_topics - excluded_topics)}\")\n","    print(f\"Percentage overlap: {(len(overlap) / len(new_topics) * 100):.1f}%\")\n","\n","    if overlap:\n","        print(f\"\\n📋 Duplicate topics:\")\n","        for i, topic in enumerate(list(overlap)[:5]):\n","            print(f\"   {i+1}. {topic[:80]}...\")\n","        if len(overlap) > 5:\n","            print(f\"   ... and {len(overlap) - 5} more\")\n","\n","def view_statistics():\n","    \"\"\"Display statistics about all topic files.\"\"\"\n","    files_to_check = [EXCLUSION_FILE, TOPICS_FILE, MASTER_FILE]\n","\n","    print(f\"\\n{'='*70}\")\n","    print(f\"📈 TOPIC STATISTICS\")\n","    print(f\"{'='*70}\")\n","\n","    for filepath in files_to_check:\n","        if os.path.exists(filepath):\n","            try:\n","                with open(filepath, \"r\", encoding=\"utf-8\") as f:\n","                    topics = json.load(f)\n","                    print(f\"\\n📁 {filepath}:\")\n","                    print(f\"   Topics: {len(topics)}\")\n","\n","                    # Count by era (simple heuristic)\n","                    era_counts = {}\n","                    era_keywords = {\n","                        \"Pre-Colonial\": [\"pre-colonial\", \"precolonial\", \"before spanish\", \"ancient\"],\n","                        \"Spanish\": [\"spanish\", \"colonial\", \"galleon\", \"friar\"],\n","                        \"American\": [\"american\", \"commonwealth\", \"war\"],\n","                        \"Japanese\": [\"japanese\", \"wwii\", \"world war\"],\n","                        \"Modern\": [\"modern\", \"contemporary\", \"republic\", \"martial law\"]\n","                    }\n","\n","                    for topic in topics:\n","                        topic_lower = topic.lower()\n","                        for era, keywords in era_keywords.items():\n","                            if any(keyword in topic_lower for keyword in keywords):\n","                                era_counts[era] = era_counts.get(era, 0) + 1\n","                                break\n","\n","                    if era_counts:\n","                        print(f\"   Era distribution:\")\n","                        for era, count in era_counts.items():\n","                            percentage = (count / len(topics)) * 100\n","                            print(f\"     • {era}: {count} ({percentage:.1f}%)\")\n","            except Exception as e:\n","                print(f\"⚠️  Error reading {filepath}: {e}\")\n","        else:\n","            print(f\"\\n❌ {filepath}: File not found\")\n","\n","def reset_for_new_session():\n","    \"\"\"\n","    Prepare for a new session by backing up the master file as new exclusion file.\n","    Clears the current topics file for fresh generation.\n","    \"\"\"\n","    print(f\"\\n{'='*70}\")\n","    print(f\"🔄 RESETTING FOR NEW SESSION\")\n","    print(f\"{'='*70}\")\n","\n","    if not os.path.exists(MASTER_FILE):\n","        print(\"❌ Master file not found. Please run combine_and_create_master() first.\")\n","        return\n","\n","    # 1. Backup current master file as new exclusion file\n","    timestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n","    new_exclusion_file = f\"topics_exclusion_{timestamp}.json\"\n","\n","    shutil.copy2(MASTER_FILE, new_exclusion_file)\n","    print(f\"✅ Created new exclusion file: {new_exclusion_file}\")\n","\n","    # 2. Copy master file to become the new exclusion file for next time\n","    shutil.copy2(MASTER_FILE, EXCLUSION_FILE)\n","    print(f\"✅ Updated {EXCLUSION_FILE} with master topics\")\n","\n","    # 3. Clear current topics file\n","    with open(TOPICS_FILE, \"w\", encoding=\"utf-8\") as f:\n","        json.dump([], f, indent=4, ensure_ascii=False)\n","    print(f\"✅ Cleared {TOPICS_FILE} for fresh generation\")\n","\n","    # 4. Optionally rename master file to archive it\n","    archived_master = f\"archive/master_topics_{timestamp}.json\"\n","    if not os.path.exists(\"archive\"):\n","        os.makedirs(\"archive\")\n","    shutil.move(MASTER_FILE, archived_master)\n","    print(f\"✅ Archived master file to: {archived_master}\")\n","\n","    print(f\"\\n✅ Ready for new session!\")\n","    print(f\"   New exclusion file: {new_exclusion_file}\")\n","    print(f\"   {TOPICS_FILE} is empty and ready for new topics\")\n","\n","if __name__ == \"__main__\":\n","    # Generate topics and combine files\n","    topics = generate_topics_to_target(target_count=875, batch_size=10)\n","\n","    # Optional: Analyze results\n","    analyze_topic_overlap()\n","    view_statistics()\n","\n","    # Optional: Reset for next session\n","    # reset_for_new_session()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Gz5DeRPShHPy","executionInfo":{"status":"ok","timestamp":1770902150101,"user_tz":-480,"elapsed":78,"user":{"displayName":"LectorFrostbite","userId":"07900419769422003588"}},"outputId":"55d24843-9808-483b-87c2-cbb69422434f"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["🎯 Target: 875 unique, factual Philippine history topics\n","📊 Batch size: 10\n","📁 Exclusion file: existing_topics_to_exclude.json\n","📁 Master file: all_topics_master.json\n","📁 Current topics file: topics_list.json\n","\n","📁 Loaded 876 topics from current file\n","📁 Loaded 75 topics from exclusion file\n","📚 Total existing topics (including exclusion): 876\n","📚 Starting with 876 topics to exclude\n","🎉 Already reached target count! 876/875\n