  Generated 878 total topics\n","   Saved to: topics_list.json\n","======================================================================\n","\n","\n","======================================================================\n","🔄 Combining topics into master file...\n","======================================================================\n","💾 Created backup: topic_backups/20260213_085537_existing_topics_to_exclude.json\n","💾 Created backup: topic_backups/20260213_085537_topics_list.json\n","📁 Added 75 topics from existing_topics_to_exclude.json\n","📁 Added 878 topics from topics_list.json\n","\n","✅ Master file created: all_topics_master.json\n","📊 Summary:\n","   Total topics from all sources: 953\n","   Duplicates removed: 75\n","   Unique topics in master file: 878\n","   Sources combined: ['existing_topics_to_exclude.json (75)', 'topics_list.json (878)']\n","📋 Metadata saved to: all_topics_master_metadata.json\n"]}]},{"cell_type":"markdown","source":["# Cell 3: Knowledge Distillation (Dataset Generation)\n","This cell reads the topics from the file and generates the final Q&A dataset."],"metadata":{"id":"S3uu696Zh0ti"}},{"cell_type":"code","source":["# --- Helper functions with token optimization + TIMEOUT HANDLING ---\n","\n","import signal\n","import time\n","import os\n","import json\n","from contextlib import contextmanager\n","\n","class TimeoutError(Exception):\n","    pass\n","\n","@contextmanager\n","def timeout(seconds):\n","    \"\"\"Context manager for timing out long-running operations.\"\"\"\n","    def timeout_handler(signum, frame):\n","        raise TimeoutError(f\"Operation timed out after {seconds} seconds\")\n","\n","    # Set the signal handler and alarm\n","    old_handler = signal.signal(signal.SIGALRM, timeout_handler)\n","    signal.alarm(seconds)\n","\n","    try:\n","        yield\n","    finally:\n","        # Restore the old handler and cancel the alarm\n","        signal.alarm(0)\n","        signal.signal(signal.SIGALRM, old_handler)\n","\n","def generate_english_questions_for_topic(topic, global_seen_questions, max_retries=5, timeout_seconds=60):\n","    print(f\"📝 Generating Master English questions: {topic}\")\n","    memory_buffer = \" | \".join(global_seen_questions[-20:])\n","\n","    prompt = f\"\"\"\n","    Topic: {topic}\n","\n","    Generate 5 distinct questions in English about the CULTURAL aspects of this topic.\n","\n","    STYLE GUIDELINES:\n","    1. Avoid \"Historical Fact\" questions (e.g., \"When was this tradition started?\", \"Who invented this food?\").\n","    2. Focus on \"Meaning\", \"Social Values\", \"Ritual\", and \"Identity\".\n","    3. Make the questions sound like a curious university student asking a Cultural Studies professor.\n","\n","    Example of BAD: \"What are the ingredients of Sinigang?\"\n","    Example of GOOD: \"How does the Filipino preference for 'asim' (sourness) in Sinigang reflect the local environment and the concept of 'comfort' in our food culture?\"\n","\n","    Avoid themes: [{memory_buffer}]\n","    Return ONLY JSON list: [{{\"question\": \"...\"}}]\n","    \"\"\"\n","\n","    for attempt in range(max_retries):\n","        try:\n","            print(f\"  Attempt {attempt + 1}/{max_retries}...\")\n","\n","            with timeout(timeout_seconds):\n","                raw_output = call_glm_with_retry(prompt, \"You are a cultural researcher and anthropologist.\", temperature=0.7)\n","\n","            if not raw_output:\n","                print(f\"  ⚠️ Empty response on attempt {attempt + 1}\")\n","                continue\n","\n","            parsed = json.loads(clean_json_output(raw_output))\n","            questions = [item['question'] for item in parsed]\n","\n","            if len(questions) == 5:  # Validate we got 5 questions\n","                global_seen_questions.extend(questions)\n","                print(f\"  ✅ Generated {len(questions)} questions\")\n","                return questions\n","            else:\n","                print(f\"  ⚠️ Got {len(questions)} questions instead of 5\")\n","\n","        except TimeoutError as e:\n","            print(f\"  ⏱️ Timeout on attempt {attempt + 1}: {e}\")\n","            time.sleep(2 ** attempt)  # Exponential backoff\n","        except json.JSONDecodeError as e:\n","            print(f\"  ⚠️ JSON error on attempt {attempt + 1}: {e}\")\n","            time.sleep(2)\n","        except Exception as e:\n","            print(f\"  ⚠️ Error on attempt {attempt + 1}: {e}\")\n","            time.sleep(2)\n","\n","    print(f\"  ❌ Failed after {max_retries} attempts\")\n","    return []\n","\n","def translate_and_answer_batch(questions, topic, language, max_retries=5, timeout_seconds=90):\n","    \"\"\"Processes all questions for a topic in ONE API call (High Token Efficiency).\"\"\"\n","    print(f\"🌍 Batching {len(questions)} questions for {language}...\")\n","\n","    # Format questions with clear numbering\n","    formatted_qs = \"\\n\".join([f\"{i+1}. {q}\" for i, q in enumerate(questions)])\n","\n","    # Dynamic System Prompt based on Language\n","    tone_instruction = \"\"\n","    if language == \"Tagalog\":\n","        tone_instruction = \"Use natural, conversational Filipino. Avoid deep/archaic Tagalog (Malalim na Tagalog). Use 'Taglish' only for modern technical terms if necessary, but prefer natural phrasing.\"\n","    elif language == \"Cebuano\":\n","        tone_instruction = \"Use natural Cebuano Bisaya as spoken in everyday conversation. Avoid mixing with Hiligaynon/Waray. Use particles (ba, diay, man, lagi) to sound authentic.\"\n","    elif language == \"Ilocano\":\n","        tone_instruction = \"Use standard but natural Ilocano. Ensure proper use of honorifics/particles where applicable to sound respectful yet conversational.\"\n","\n","    prompt = f\"\"\"\n","    Topic: {topic}\n","    Target Language: {language}\n","\n","    Questions to Process:\n","    {formatted_qs}\n","\n","    TASK:\n","    For each question above, you must:\n","    1. Translate the question into {language}. Make it sound like a native speaker asking about their own heritage.\n","    2. Answer the question in {language} (3-5 sentences).\n","\n","    CRITICAL TONE GUIDE:\n","    - {tone_instruction}\n","    - Do NOT sound like a robot or a dry textbook.\n","    - Sound like a \"Cultural Bearer\" or a knowledgeable elder/local explaining the 'soul' of a tradition to a friend.\n","    - Focus on the \"Why\" behind the practice and its significance to the community today.\n","\n","    REQUIRED OUTPUT FORMAT:\n","    Return EXACTLY {len(questions)} items in a JSON array.\n","    Each item must have:\n","    - \"id\": Use the question number from above (1, 2, 3, 4, 5)\n","    - \"translated_question\": The translated question\n","    - \"answer\": The answer in {language}\n","\n","    Example Structure:\n","    [\n","        {{\"id\": 1, \"translated_question\": \"...\", \"answer\": \"...\"}},\n","        {{\"id\": 2, \"translated_question\": \"...\", \"answer\": \"...\"}},\n","        {{\"id\": 3, \"translated_question\": \"...\", \"answer\": \"...\"}},\n","        {{\"id\": 4, \"translated_question\": \"...\", \"answer\": \"...\"}},\n","        {{\"id\": 5, \"translated_question\": \"...\", \"answer\": \"...\"}}\n","    ]\n","\n","    Return ONLY the JSON array, no additional text.\n","    \"\"\"\n","\n","    sys_msg = f\"Expert cultural consultant and {language} translator. Return valid JSON only.\"\n","\n","    for attempt in range(max_retries):\n","        try:\n","            print(f\"  Attempt {attempt + 1}/{max_retries}...\")\n","\n","            # Use timeout to prevent hanging\n","            with timeout(timeout_seconds):\n","                raw_output = call_glm_with_retry(prompt, system_prompt=sys_msg, temperature=0.2)\n","\n","            if not raw_output:\n","                print(f\"  ⚠️ Empty response on attempt {attempt + 1}/{max_retries}\")\n","                time.sleep(2 ** attempt)  # Exponential backoff\n","                continue\n","\n","            cleaned = clean_json_output(raw_output)\n","            parsed = json.loads(cleaned)\n","\n","            # Validate it's a list\n","            if not isinstance(parsed, list):\n","                print(f\"  ⚠️ Response is not a list on attempt {attempt + 1}/{max_retries}\")\n","                time.sleep(2)\n","                continue\n","\n","            # Validate we got the right number of items\n","            if len(parsed) != len(questions):\n","                print(f\"  ⚠️ Expected {len(questions)} items, got {len(parsed)} on attempt {attempt + 1}/{max_retries}\")\n","                time.sleep(2)\n","                continue\n","\n","            # Validate each item has required fields\n","            valid_batch = True\n","            for item in parsed:\n","                if not all(key in item for key in ['id', 'translated_question', 'answer']):\n","                    print(f\"  ⚠️ Missing required fields in item on attempt {attempt + 1}/{max_retries}\")\n","                    valid_batch = False\n","                    break\n","                # Check for empty values\n","                if not item.get('translated_question', '').strip() or not item.get('answer', '').strip():\n","                    print(f\"  ⚠️ Empty question or answer in item on attempt {attempt + 1}/{max_retries}\")\n","                    valid_batch = False\n","                    break\n","\n","            if valid_batch:\n","                print(f\"  ✅ Successfully processed batch\")\n","                return parsed\n","            else:\n","                time.sleep(2)\n","\n","        except TimeoutError as e:\n","            print(f\"  ⏱️ Timeout on attempt {attempt + 1}/{max_retries}: {e}\")\n","            time.sleep(2 ** attempt)  # Exponential backoff\n","        except json.JSONDecodeError as e:\n","            print(f\"  ⚠️ JSON decode error on attempt {attempt + 1}/{max_retries}: {str(e)[:100]}\")\n","            time.sleep(2)\n","        except Exception as e:\n","            print(f\"  ⚠️ Unexpected error on attempt {attempt + 1}/{max_retries}: {str(e)[:100]}\")\n","            time.sleep(2)\n","\n","    print(f\"  ❌ Failed to get valid batch for topic '{topic}' after {max_retries} attempts\")\n","    return []\n","\n","# --- MAIN EXECUTION ---\n","# Ensure the DRIVE_PATH exists from the kernel state\n","DRIVE_PATH = '/content/drive/MyDrive/PhCultureDataset-ilc' # Defined in kernel state\n","\n","LANGUAGES = [\"Ilocano\"]\n","# LANGUAGES = [\"Tagalog\", \"Cebuano\", \"Ilocano\"]\n","MASTER_QUESTIONS_FILE = os.path.join(DRIVE_PATH, \"master_questions.json\")\n","DATASET_FILE_PREFIX = os.path.join(DRIVE_PATH, \"ph_culture_ilc\")\n","\n","# Configuration\n","QUESTION_TIMEOUT = 60  # seconds for question generation\n","BATCH_TIMEOUT = 120    # seconds for batch translation/answering\n","MAX_RETRIES = 5\n","\n","if os.path.exists(TOPICS_FILE):\n","    with open(TOPICS_FILE, \"r\") as f:\n","        all_topics = json.load(f)\n","        # Only take rows 1-267 (indices 0-266)\n","        topics_to_process = all_topics[609:876]\n","\n","    # STEP 1: Generate & Save Master English Questions\n","    global_seen_english_questions = []\n","    questions_map = {}\n","    failed_topics = []\n","\n","    print(f\"\\n{'='*70}\")\n","    print(f\"🚀 Phase 1: Generating Master English Questions...\")\n","    print(f\"   Timeout per topic: {QUESTION_TIMEOUT}s\")\n","    print(f\"   Max retries: {MAX_RETRIES}\")\n","    print(f\"{'='*70}\\n\")\n","\n","    for idx, topic in enumerate(topics_to_process, 1):\n","        print(f\"\\n[{idx}/{len(topics_to_process)}] Topic: {topic[:60]}...\")\n","\n","        qs = generate_english_questions_for_topic(\n","            topic,\n","            global_seen_english_questions,\n","            max_retries=MAX_RETRIES,\n","            timeout_seconds=QUESTION_TIMEOUT\n","        )\n","\n","        if qs and len(qs) == 5:\n","            questions_ma