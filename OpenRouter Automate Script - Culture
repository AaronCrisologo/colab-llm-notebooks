{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"1kcayzwSimg77--hJWVlzt0ddW7u69u6T","timestamp":1770531919363},{"file_id":"1-mxXYNoUTmkMOmp9imJ6mVridArhs6Of","timestamp":1770505959689}],"mount_file_id":"1IJ390zl-gngHFij9qOme-G50YUtjbpbn","authorship_tag":"ABX9TyNkCQZJzmX57Q8ey6Y/dh82"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":["# Setup and Utilities\n","\n","This cell handles imports, API configuration, and the shared helper functions.\n","\n","\n","\n","\n"],"metadata":{"id":"vhJuF3GGhNFj"}},{"cell_type":"code","source":["import os\n","import re\n","import json\n","import time\n","import requests\n","from google.colab import userdata\n","\n","# --- CONFIGURATION ---\n","OPENROUTER_API_KEY = userdata.get('OPENROUTER_API_KEY')\n","MODEL_NAME = \"qwen/qwen3-235b-a22b-2507\"\n","TOPICS_FILE = \"topics_list.json\"\n","DATASET_FILE = \"ph_history_dataset.jsonl\"\n","\n","def call_glm_with_retry(prompt, system_prompt=\"You are an expert historian.\", max_retries=20, temperature=0.7):\n","    delay = 2\n","    for i in range(max_retries):\n","        try:\n","            response = requests.post(\n","                url=\"https://openrouter.ai/api/v1/chat/completions\",\n","                headers={\n","                    \"Authorization\": f\"Bearer {OPENROUTER_API_KEY}\",\n","                    \"Content-Type\": \"application/json\",\n","                },\n","                data=json.dumps({\n","                    \"model\": MODEL_NAME,\n","                    \"temperature\": temperature,\n","                    \"messages\": [\n","                        {\"role\": \"system\", \"content\": system_prompt},\n","                        {\"role\": \"user\", \"content\": prompt}\n","                    ],\n","                    \"provider\": {\n","                      # Order: 1st DeepInfra, 2nd Novita, 3rd SiliconFlow\n","                      \"order\": [\"wandb\", \"DeepInfra\", \"Novita\", \"SiliconFlow\"],\n","                      \"quantizations\": [\"bf16\", \"fp8\"],\n","                      \"allow_fallbacks\": True\n","                    }\n","                })\n","            )\n","            if response.status_code == 200:\n","                return response.json()['choices'][0]['message']['content']\n","            elif response.status_code in [429, 402]:\n","                print(f\"Rate limit/Balance hit ({response.status_code}). Retrying in {delay}s...\")\n","                time.sleep(delay)\n","                delay *= 2\n","            else:\n","                print(f\"API Error {response.status_code}: {response.text}\")\n","                break\n","        except Exception as e:\n","            print(f\"Network Error: {e}\")\n","            time.sleep(delay)\n","            delay *= 2\n","    return None\n","\n","def clean_json_output(raw_output):\n","    if not raw_output: return \"\"\n","    # Remove Markdown code blocks\n","    text = raw_output.replace(\"```json\", \"\").replace(\"```\", \"\").strip()\n","    # Find the first '[' and last ']' to isolate the array\n","    start = text.find(\"[\")\n","    end = text.rfind(\"]\")\n","    if start != -1 and end != -1:\n","        return text[start:end+1]\n","    return text"],"metadata":{"id":"0OlH_jj-hFVm","executionInfo":{"status":"ok","timestamp":1771057556492,"user_tz":-480,"elapsed":1165,"user":{"displayName":"LectorFrostbite","userId":"07900419769422003588"}}},"execution_count":3,"outputs":[]},{"cell_type":"markdown","source":["# Cell 2: Topic Generation\n","Run this once to generate your topics. It saves them to topics_list.json."],"metadata":{"id":"bcwhbhcmhvCk"}},{"cell_type":"code","source":["import json\n","import os\n","import random\n","import time\n","from typing import List, Set, Dict\n","\n","# Define the filename clearly\n","TOPICS_FILE = \"topics_list.json\"\n","VALIDATION_LOG = \"validation_log.json\"\n","\n","# Add these constants at the top with other configurations\n","EXCLUSION_FILE = \"existing_topics_to_exclude.json\"  # Your existing topics file\n","MASTER_FILE = \"all_topics_master.json\"  # Combined master file\n","BACKUP_DIR = \"topic_backups\"  # Directory for backups\n","\n","# Updated thematic lenses with 80% culture, 20% religious influence\n","THEMATIC_LENSES = [\n","    \"Material Culture (Textiles, Pottery, Architecture, Everyday Objects)\",\n","    \"Performing Arts & Festivals (Dance, Theater, Music, Regional Celebrations)\",\n","    \"Culinary Traditions (Indigenous Cuisine, Colonial Influences, Foodways)\",\n","    \"Language & Oral Traditions (Folklore, Proverbs, Storytelling, Linguistic Evolution)\",\n","    \"Social Customs & Kinship Systems (Family Structures, Marriage Rites, Community Bonds)\",\n","    \"Traditional Crafts & Livelihoods (Weaving, Fishing, Farming, Artisanal Skills)\",\n","    \"Folk Medicine & Healing Practices (Herbal Lore, Massage Techniques, Ritual Healing)\",\n","    \"Dress & Adornment (Traditional Clothing, Jewelry, Body Modifications, Status Markers)\",\n","    \"Games & Leisure (Traditional Sports, Children's Games, Recreational Activities)\",\n","    \"Religious Influences on Cultural Practices (Syncretic Rituals, Religious Festivals)\",\n","    \"Architecture & Spatial Organization (House Designs, Settlement Patterns, Sacred Spaces)\",\n","    \"Agricultural & Environmental Practices (Farming Methods, Resource Management)\",\n","    \"Trade & Exchange Networks (Local Markets, Inter-island Trade, Cultural Diffusion)\",\n","    \"Life Cycle Rituals (Birth, Coming-of-Age, Marriage, Death Traditions)\",\n","    \"Visual Arts & Aesthetics (Tattooing, Carving, Painting, Decorative Patterns)\",\n","    \"Maritime Technology & Navigation (Boat-building, Celestial Navigation, Sea-lore)\",\n","    \"Indigenous Governance & Customary Law (Barangay Structures, Peace Pacts, Oral Codes)\",\n","    \"Ethno-Astronomy & Timekeeping (Indigenous Calendars, Star Lore, Seasonal Cycles)\",\n","    \"Weaponry & Martial Traditions (Traditional Blades, Arnis/Kali History, Defensive Forts)\",\n","    \"Musicology & Soundscapes (Indigenous Instruments, Ritual Chants, Sound Symbols)\",\n","    \"Eco-Cultural Landscapes (Sacred Mountains, Forest Management, Riverine Settlements)\",\n","    \"Urbanization & Civic Spaces (Plaza Complex, Colonial Urban Planning, Street Culture)\",\n","    \"Childhood & Pedagogy (Traditional Child-rearing, Games as Education, Apprenticeships)\",\n","    \"Textual Culture & Literacy (Writing on Bamboo, Rare Manuscripts, Printing Press Impact)\",\n","    \"Political Iconography (Revolutionary Flags, Seals, Symbols of Resistance/Authority)\"\n","]\n","\n","# FACTUAL ANCHOR POINTS - Real documented cultural/religious topics\n","FACTUAL_ANCHORS = {\n","    \"Pre-Colonial Era\": [\n","        \"Tattooing traditions of the Visayans (pintados)\", \"Anito worship and spirit houses\",\n","        \"Baybayin script and writing practices\", \"Traditional boat-building (balangay)\",\n","        \"Indigenous textile patterns (ikat, binulan)\", \"Oral epics (Hudhud, Biag ni Lam-ang)\",\n","        \"Bathala and pre-colonial deity concepts\", \"Shamanic practices (babaylan, catalonan)\"\n","    ],\n","    \"Spanish Colonial\": [\n","        \"Syncretic religious festivals (Pahiyas, Ati-Atihan)\", \"Folk Catholicism adoption\",\n","        \"Traditional clothing adaptation (baro't saya, barong tagalog)\", \"Stone church architecture\",\n","        \"Mestizo culture emergence\", \"Cockfighting (sabong) traditions\",\n","        \"Hispano-Filipino musical forms (kundiman, harana)\", \"Culinary fusion (adobo, lechon)\"\n","    ],\n","    \"American Period\": [\n","        \"Public education impact on local languages\", \"Hollywood influence on entertainment\",\n","        \"Baseball and basketball adoption\", \"English language incorporation\",\n","        \"Protestant missionary cultural impacts\", \"Modernization of traditional arts\",\n","        \"Mass media and popular culture\", \"American-style festivals and celebrations\"\n","    ],\n","    \"Post-War & Modern\": [\n","        \"Jeepney culture and art\", \"Regional festival revival movements\",\n","        \"Filipino diaspora cultural retention\", \"Indigenous cultural revitalization\",\n","        \"Pop culture (komiks, teleseryes)\", \"Fusion cuisine trends\",\n","        \"Contemporary art movements\", \"Heritage conservation efforts\"\n","    ],\n","    \"Regional Specific\": [\n","        \"Maranao okir designs\", \"Ifugao rice terrace rituals\", \"T'boli t'nalak weaving\",\n","        \"Kapampangan culinary heritage\", \"Ilocano tobacco culture\", \"Bicolano chili traditions\",\n","        \"Waray waray folk songs\", \"Hiligaynon festival dances\"\n","    ],\n","    \"Maritime & Trade\": [\n","        \"Butuan Ivory Seal and silver paleograph\", \"Sulu Sultanate maritime trade protocols\",\n","        \"Galleon Trade botanical exchanges\", \"The 'Visayan Islands' as a trade hub for porcelain\",\n","        \"Vinta and Paraw: Hydrodynamics of indigenous hulls\"\n","    ],\n","    \"Ethnolinguistic Specifics\": [\n","        \"Tausug 'Pangalay' dance and bird-mimicry\", \"Ivatan 'Sinadumparan' stone houses\",\n","        \"Mangyan 'Ambahan' bamboo poetry\", \"Subanen 'Guman' epics\",\n","        \"Gaddang beadwork and status finery\"\n","    ],\n","    \"Sociopolitical Transitions\": [\n","        \"The 'Principalia' class and cultural gatekeeping\", \"The Propaganda Movement’s literary impact\",\n","        \"1904 St. Louis World's Fair: Display of indigenous Filipinos\",\n","        \"Commonwealth-era 'National Language' debates\",\n","        \"The impact of the 1970s 'Folk Revival' on OPM (Original Pilipino Music)\"\n","    ],\n","    \"Scientific & Environmental History\": [\n","        \"Indigenous irrigation systems (Payoh) of the Cordilleras\",\n","        \"Traditional salt-making (Asin Tibuok) in Bohol\",\n","        \"Colonial-era botanical gardens and 'Materia Medica'\",\n","        \"The use of 'Anting-anting' (amulets) in peasant revolts\"\n","    ]\n","}\n","\n","def load_existing_topics() -> List[str]:\n","    \"\"\"Load existing topics from multiple sources to exclude them.\"\"\"\n","    existing_topics = []\n","\n","    # 1. Load from current file (if any)\n","    if os.path.exists(TOPICS_FILE):\n","        try:\n","            with open(TOPICS_FILE, \"r\", encoding=\"utf-8\") as f:\n","                content = f.read()\n","                if content:\n","                    existing_topics.extend(json.loads(content))\n","                    print(f\"📁 Loaded {len(json.loads(content))} topics from current file\")\n","        except (json.JSONDecodeError, IOError) as e:\n","            print(f\"⚠️  Error loading current topics: {e}\")\n","\n","    # 2. Load from exclusion file (your existing topics)\n","    if os.path.exists(EXCLUSION_FILE):\n","        try:\n","            with open(EXCLUSION_FILE, \"r\", encoding=\"utf-8\") as f:\n","                content = f.read()\n","                if content:\n","                    excluded = json.loads(content)\n","                    existing_topics.extend(excluded)\n","                    print(f\"📁 Loaded {len(excluded)} topics from exclusion file\")\n","        except (json.JSONDecodeError, IOError) as e:\n","            print(f\"⚠️  Error loading exclusion topics: {e}\")\n","\n","    # Remove duplicates while preserving order\n","    seen = set()\n","    deduped = []\n","    for topic in existing_topics:\n","        if topic not in seen:\n","            seen.add(topic)\n","            deduped.append(topic)\n","\n","    print(f\"📚 Total existing topics (including exclusion): {len(deduped)}\")\n","    return deduped\n","\n","def save_topics(topics: List[str]):\n","    \"\"\"Save topics to JSON file.\"\"\"\n","    with open(TOPICS_FILE, \"w\", encoding=\"utf-8\") as f:\n","        json.dump(topics, f, indent=4, ensure_ascii=False)\n","\n","def extract_core_entities(topics: List[str]) -> Set[str]:\n","    \"\"\"Extract key entities/subjects from existing topics to avoid repetition.\"\"\"\n","    entities = set()\n","    common_words = {\"the\", \"of\", \"and\", \"in\", \"a\", \"an\", \"to\", \"from\", \"era\", \"period\",\n","                   \"cultural\", \"culture\", \"religious\", \"religion\", \"practice\", \"tradition\"}\n","\n","    for topic in topics:\n","        # Extract meaningful words (simple approach)\n","        words = topic.lower().replace(\":\", \" \").replace(\"-\", \" \").split()\n","        meaningful_words = [w for w in words if len(w) > 4 and w not in common_words]\n","        entities.update(meaningful_words[:3])  # First 3 meaningful words\n","\n","    return entities\n","\n","def create_anti_hallucination_prompt(\n","    count: int,\n","    lens: str,\n","    existing_topics: List[str],\n","    used_entities: Set[str],\n","    batch_number: int\n",") -> str:\n","    \"\"\"Create a prompt with strong anti-hallucination guardrails.\"\"\"\n","\n","    # Select random factual anchors from relevant eras\n","    anchor_examples = []\n","    for era, topics in FACTUAL_ANCHORS.items():\n","        anchor_examples.extend(random.sample(topics, min(2, len(topics))))\n","    random.shuffle(anchor_examples)\n","    anchor_str = \", \".join(anchor_examples[:8])\n","\n","    # Create exclusion context\n","    recent_topics = existing_topics[-50:] if len(existing_topics) > 50 else existing_topics\n","    exclusion_sample = json.dumps(recent_topics[:20], ensure_ascii=False)\n","\n","    overused_entities = \", \".join(list(used_entities)[:30])\n","\n","    prompt = f\"\"\"You are a Philippine cultural studies scholar with expertise in {lens}.\n","\n","**MISSION**: Generate {count} historically accurate, verifiable topics for Philippine **CULTURAL** history research with **limited religious influence** (80% cultural, 20% religious connections).\n","\n","**CRITICAL RULE - ZERO TOLERANCE FOR HALLUCINATION**:\n","- Every topic MUST reference a real, documented cultural practice, tradition, artifact, or phenomenon\n","- If you're uncertain about ANY detail, DO NOT include it\n","- Cross-reference mentally against known cultural facts before suggesting\n","- Examples of REAL cultural elements you can build from: {anchor_str}\n","\n","**CURRENT THEMATIC LENS** (Batch #{batch_number}):\n","Focus Area: {lens}\n","\n","**80-20 DISTRIBUTION REQUIREMENT**:\n","- 80% PURE CULTURAL TOPICS: Focus on arts, crafts, food, language, social customs, material culture\n","- 20% CULTURE-RELIGION INTERFACE: Cultural practices with religious influences, NOT purely religious topics\n","- AVOID: Theology, church history, purely religious doctrines unless examining cultural impact\n","\n","**STRUCTURAL REQUIREMENTS**:\n","1. Use format: \"The [Cultural Subject]: [Specific Analytical Angle]\"\n","2. AVOID years in titles unless essential (prefer \"Spanish Colonial Era\", \"American Period\")\n","3. Mix these approaches:\n","   - Anthropological: social structures, kinship, community practices\n","   - Material: artifacts, architecture, everyday objects\n","   - Performative: festivals, dances, music, theater\n","   - Linguistic: language evolution, oral traditions, storytelling\n","   - Economic: crafts, trade, livelihood systems\n","   - Comparative: regional variations, cross-cultural exchanges\n","\n","**DIVERSITY REQUIREMENTS**:\n","- 40% Pre-colonial and indigenous cultural practices\n","- 30% Colonial period cultural adaptations and syncretism\n","- 20% Regional and ethnic group specific traditions\n","- 10% Modern cultural transformations and revitalization\n","\n","**STRICT EXCLUSIONS**:\n","1. DO NOT repeat or create variations of these recent topics: {exclusion_sample}\n","2. MINIMIZE these overused entities: {overused_entities}\n","3. NEVER invent cultural practices, festivals, or traditions that didn't exist\n","4. AVOID generic titles like \"The Culture of...\" or \"Overview of...\"\n","5. LIMIT religious content to 20% of topics - focus on cultural manifestations\n","\n","**VERIFICATION CHECKLIST** (mentally verify each before including):\n","□ Is this cultural practice/tradition documented in historical or anthropological records?\n","□ Can I name at least one ethnic group or region associated with this practice?\n","□ Is this distinct from the exclusion list?\n","□ Does this fit the 80-20 cultural-religious distribution?\n","□ Does this focus primarily on CULTURAL aspects rather than religious doctrine?\n","\n","**OUTPUT FORMAT**:\n","Return ONLY a valid JSON array of strings. Example:\n","[\n","  \"The Pintados Tattoo Tradition: Status Markers and Aesthetic Values in Pre-colonial Visayas\",\n","  \"The Pahiyas Festival: Agricultural Gratitude and Architectural Decoration in Lucban, Quezon\"\n","]\n","\n","Generate {count} topics now:\"\"\"\n","\n","    return prompt\n","\n","def validate_topics_for_hallucination(topics: List[str]) -> tuple[List[str], List[str]]:\n","    \"\"\"\n","    Basic validation to catch obvious hallucinations.\n","    Returns: (valid_topics, suspicious_topics)\n","    \"\"\"\n","    valid = []\n","    suspicious = []\n","\n","    # Updated red flags for cultural topics\n","    red_flag_patterns = [\n","        \"1907\", \"1908\", \"1909\",  # Random uncommon years\n","        \"Sacred\", \"Divine\", \"Holy\",  # Overly religious without cultural context\n","        \"Secret Society\", \"Hidden Cult\",  # Vague, hard to verify\n","        \"Ancient Temple\", \"Lost City\",  # Archeological speculation\n","        \"Pure\", \"Original\", \"Authentic\",  # Essentialist claims\n","    ]\n","\n","    for topic in topics:\n","        is_suspicious = any(flag.lower() in topic.lower() for flag in red_flag_patterns)\n","\n","        # Check for excessive religious focus\n","        religious_keywords = [\"church\", \"doctrine\", \"theology\", \"baptism\", \"eucharist\", \"priest\"]\n","        religious_count = sum(1 for keyword in religious_keywords if keyword in topic.lower())\n","        if religious_count > 2:  # Too religious-focused\n","            is_suspicious = True\n","\n","        # Additional check: topics that are too vague\n","        if len(topic) < 20 or topic.count(\" \") < 3:\n","            is_suspicious = True\n","\n","        if is_suspicious:\n","            suspicious.append(topic)\n","        else:\n","            valid.append(topic)\n","\n","    return valid, suspicious\n","\n","def check_similarity(new_topic: str, existing_topics: List[str], threshold: float = 0.6) -> bool:\n","    \"\"\"\n","    Simple similarity check using word overlap.\n","    Returns True if topic is too similar to existing ones.\n","    \"\"\"\n","    new_words = set(new_topic.lower().split())\n","\n","    for existing in existing_topics:\n","        existing_words = set(existing.lower().split())\n","\n","        # Jaccard similarity\n","        intersection = len(new_words & existing_words)\n","        union = len(new_words | existing_words)\n","\n","        if union > 0:\n","            similarity = intersection / union\n","            if similarity > threshold:\n","                return True\n","\n","    return False\n","\n","def generate_batch(\n","    batch_size: int,\n","    lens: str,\n","    existing_topics: List[str],\n","    used_entities: Set[str],\n","    batch_number: int\n",") -> List[str]:\n","    \"\"\"Generate a single batch of topics with validation.\"\"\"\n","\n","    prompt = create_anti_hallucination_prompt(\n","        count=batch_size,\n","        lens=lens,\n","        existing_topics=existing_topics,\n","        used_entities=used_entities,\n","        batch_number=batch_number\n","    )\n","\n","    # Call your LLM function here\n","    # Replace with your actual API call\n","    result = call_glm_with_retry(prompt, \"Cultural Historian and Researcher\", temperature=0.3)\n","\n","    if not result:\n","        return []\n","\n","    try:\n","        new_topics = json.loads(clean_json_output(result))\n","\n","        # Validate for hallucinations\n","        valid_topics, suspicious_topics = validate_topics_for_hallucination(new_topics)\n","\n","        if suspicious_topics:\n","            print(f\"⚠️  Filtered {len(suspicious_topics)} suspicious topics: {suspicious_topics[:3]}\")\n","\n","        # Deduplicate against existing\n","        unique_topics = []\n","        for topic in valid_topics:\n","            if topic not in existing_topics and not check_similarity(topic, existing_topics):\n","                unique_topics.append(topic)\n","\n","        return unique_topics\n","\n","    except Exception as e:\n","        print(f\"❌ Error parsing batch: {e}\")\n","        return []\n","\n","def create_backup(filepath: str):\n","    \"\"\"Create timestamped backup of a file.\"\"\"\n","    import shutil\n","    from datetime import datetime\n","\n","    if not os.path.exists(BACKUP_DIR):\n","        os.makedirs(BACKUP_DIR)\n","\n","    if os.path.exists(filepath):\n","        timestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n","        filename = os.path.basename(filepath)\n","        backup_path = os.path.join(BACKUP_DIR, f\"{timestamp}_{filename}\")\n","        shutil.copy2(filepath, backup_path)\n","        print(f\"💾 Created backup: {backup_path}\")\n","\n","def combine_and_create_master():\n","    \"\"\"\n","    Combine topics from exclusion file and newly generated file into a master file.\n","    Also creates backups of original files.\n","    \"\"\"\n","    from datetime import datetime\n","\n","    print(f\"\\n{'='*70}\")\n","    print(f\"🔄 Combining topics into master file...\")\n","    print(f\"{'='*70}\")\n","\n","    # Create backups first\n","    if os.path.exists(EXCLUSION_FILE):\n","        create_backup(EXCLUSION_FILE)\n","\n","    if os.path.exists(TOPICS_FILE):\n","        create_backup(TOPICS_FILE)\n","\n","    # Load all topics from both sources\n","    all_topics = []\n","    sources = []\n","\n","    # Load from exclusion file (existing topics)\n","    if os.path.exists(EXCLUSION_FILE):\n","        try:\n","            with open(EXCLUSION_FILE, \"r\", encoding=\"utf-8\") as f:\n","                excluded_topics = json.load(f)\n","                all_topics.extend(excluded_topics)\n","                sources.append((EXCLUSION_FILE, len(excluded_topics)))\n","                print(f\"📁 Added {len(excluded_topics)} topics from {EXCLUSION_FILE}\")\n","        except Exception as e:\n","            print(f\"⚠️  Error loading {EXCLUSION_FILE}: {e}\")\n","\n","    # Load from newly generated topics\n","    if os.path.exists(TOPICS_FILE):\n","        try:\n","            with open(TOPICS_FILE, \"r\", encoding=\"utf-8\") as f:\n","                new_topics = json.load(f)\n","                all_topics.extend(new_topics)\n","                sources.append((TOPICS_FILE, len(new_topics)))\n","                print(f\"📁 Added {len(new_topics)} topics from {TOPICS_FILE}\")\n","        except Exception as e:\n","            print(f\"⚠️  Error loading {TOPICS_FILE}: {e}\")\n","\n","    # Remove duplicates while preserving order of first appearance\n","    seen = set()\n","    unique_topics = []\n","    duplicates_count = 0\n","\n","    for topic in all_topics:\n","        if topic not in seen:\n","            seen.add(topic)\n","            unique_topics.append(topic)\n","        else:\n","            duplicates_count += 1\n","\n","    # Sort topics alphabetically for better organization (optional)\n","    unique_topics.sort()\n","\n","    # Save to master file\n","    try:\n","        with open(MASTER_FILE, \"w\", encoding=\"utf-8\") as f:\n","            json.dump(unique_topics, f, indent=4, ensure_ascii=False)\n","\n","        print(f\"\\n✅ Master file created: {MASTER_FILE}\")\n","        print(f\"📊 Summary:\")\n","        print(f\"   Total topics from all sources: {len(all_topics)}\")\n","        print(f\"   Duplicates removed: {duplicates_count}\")\n","        print(f\"   Unique topics in master file: {len(unique_topics)}\")\n","        print(f\"   Sources combined: {[f'{name} ({count})' for name, count in sources]}\")\n","\n","        # Create metadata about the merge\n","        metadata = {\n","            \"merge_date\": datetime.now().isoformat(),\n","            \"source_files\": [name for name, _ in sources],\n","            \"source_counts\": {name: count for name, count in sources},\n","            \"total_before_deduplication\": len(all_topics),\n","            \"duplicates_removed\": duplicates_count,\n","            \"total_after_deduplication\": len(unique_topics)\n","        }\n","\n","        metadata_file = MASTER_FILE.replace(\".json\", \"_metadata.json\")\n","        with open(metadata_file, \"w\", encoding=\"utf-8\") as f:\n","            json.dump(metadata, f, indent=4, ensure_ascii=False)\n","\n","        print(f\"📋 Metadata saved to: {metadata_file}\")\n","\n","        return unique_topics\n","\n","    except Exception as e:\n","        print(f\"❌ Error creating master file: {e}\")\n","        return []\n","\n","def analyze_topic_overlap():\n","    \"\"\"Analyze overlap between exclusion file and newly generated topics.\"\"\"\n","    if not os.path.exists(EXCLUSION_FILE) or not os.path.exists(TOPICS_FILE):\n","        print(\"❌ Both files must exist for analysis\")\n","        return\n","\n","    with open(EXCLUSION_FILE, \"r\", encoding=\"utf-8\") as f:\n","        excluded_topics = set(json.load(f))\n","\n","    with open(TOPICS_FILE, \"r\", encoding=\"utf-8\") as f:\n","        new_topics = set(json.load(f))\n","\n","    overlap = excluded_topics.intersection(new_topics)\n","\n","    print(f\"\\n{'='*70}\")\n","    print(f\"📊 TOPIC OVERLAP ANALYSIS\")\n","    print(f\"{'='*70}\")\n","    print(f\"Exclusion file topics: {len(excluded_topics)}\")\n","    print(f\"New topics: {len(new_topics)}\")\n","    print(f\"Overlap (duplicates): {len