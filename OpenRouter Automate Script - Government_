{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"mount_file_id":"1-mxXYNoUTmkMOmp9imJ6mVridArhs6Of","authorship_tag":"ABX9TyPQ27iZpzWyBmaBevuOa6aw"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":["# Setup and Utilities\n","\n","This cell handles imports, API configuration, and the shared helper functions.\n","\n","\n","\n","\n"],"metadata":{"id":"vhJuF3GGhNFj"}},{"cell_type":"code","source":["import os\n","import re\n","import json\n","import time\n","import requests\n","from google.colab import userdata\n","\n","# --- CONFIGURATION ---\n","OPENROUTER_API_KEY = userdata.get('OPENROUTER_API_KEY')\n","MODEL_NAME = \"qwen/qwen3-235b-a22b-2507\"\n","TOPICS_FILE = \"topics_list.json\"\n","DATASET_FILE = \"ph_history_dataset.jsonl\"\n","\n","def call_glm_with_retry(prompt, system_prompt=\"You are an expert Cultural Historian and Researcher.\", max_retries=20, temperature=0.7):\n","    delay = 2\n","    for i in range(max_retries):\n","        try:\n","            response = requests.post(\n","                url=\"https://openrouter.ai/api/v1/chat/completions\",\n","                headers={\n","                    \"Authorization\": f\"Bearer {OPENROUTER_API_KEY}\",\n","                    \"Content-Type\": \"application/json\",\n","                },\n","                data=json.dumps({\n","                    \"model\": MODEL_NAME,\n","                    \"temperature\": temperature,\n","                    \"messages\": [\n","                        {\"role\": \"system\", \"content\": system_prompt},\n","                        {\"role\": \"user\", \"content\": prompt}\n","                    ],\n","                    \"provider\": {\n","                      # Order: 1st DeepInfra, 2nd Novita, 3rd SiliconFlow\n","                      \"order\": [\"wandb\", \"DeepInfra\", \"Novita\", \"SiliconFlow\"],\n","                      \"quantizations\": [\"bf16\", \"fp8\"],\n","                      \"allow_fallbacks\": True\n","                    }\n","                })\n","            )\n","            if response.status_code == 200:\n","                return response.json()['choices'][0]['message']['content']\n","            elif response.status_code in [429, 402]:\n","                print(f\"Rate limit/Balance hit ({response.status_code}). Retrying in {delay}s...\")\n","                time.sleep(delay)\n","                delay *= 2\n","            else:\n","                print(f\"API Error {response.status_code}: {response.text}\")\n","                break\n","        except Exception as e:\n","            print(f\"Network Error: {e}\")\n","            time.sleep(delay)\n","            delay *= 2\n","    return None\n","\n","def clean_json_output(raw_output):\n","    if not raw_output: return \"\"\n","    # Remove Markdown code blocks\n","    text = raw_output.replace(\"```json\", \"\").replace(\"```\", \"\").strip()\n","    # Find the first '[' and last ']' to isolate the array\n","    start = text.find(\"[\")\n","    end = text.rfind(\"]\")\n","    if start != -1 and end != -1:\n","        return text[start:end+1]\n","    return text"],"metadata":{"id":"0OlH_jj-hFVm","executionInfo":{"status":"ok","timestamp":1771057418575,"user_tz":-480,"elapsed":1033,"user":{"displayName":"LectorFrostbite","userId":"07900419769422003588"}}},"execution_count":1,"outputs":[]},{"cell_type":"markdown","source":["# Cell 2: Topic Generation\n","Run this once to generate your topics. It saves them to topics_list.json."],"metadata":{"id":"bcwhbhcmhvCk"}},{"cell_type":"code","source":["import json\n","import os\n","import random\n","import time\n","from typing import List, Set, Dict\n","\n","# Define the filename clearly\n","TOPICS_FILE = \"topics_list.json\"\n","VALIDATION_LOG = \"validation_log.json\"\n","\n","# Add these constants at the top with other configurations\n","EXCLUSION_FILE = \"existing_topics_to_exclude.json\"  # Your existing topics file\n","MASTER_FILE = \"all_topics_master.json\"  # Combined master file\n","BACKUP_DIR = \"topic_backups\"  # Directory for backups\n","\n","# Updated thematic lenses for local governance and public services\n","THEMATIC_LENSES = [\n","    \"Barangay Governance Structure (Officials, SK, Committees, Operations)\",\n","    \"Local Legislative Processes (Ordinances, Resolutions, Public Hearings)\",\n","    \"Public Service Delivery (Health Centers, Daycare, Clean Water, Garbage Collection)\",\n","    \"Civil Registration Systems (Birth, Marriage, Death Certificates Processing)\",\n","    \"Licensing and Permits (Business, Construction, Professional, Driver's License)\",\n","    \"Local Revenue Generation (Taxation, Fees, Revenue Collection Mechanisms)\",\n","    \"Dispute Resolution Systems (Lupon Tagapamayapa, Katarungang Pambarangay)\",\n","    \"Social Welfare Programs (4Ps, Senior Citizens, PWD Assistance Distribution)\",\n","    \"Infrastructure Management (Roads, Public Buildings, Utilities Maintenance)\",\n","    \"Public Safety and Order (Tanods, Traffic Management, Disaster Response)\",\n","    \"Education and Youth Services (Public Schools, Scholarships, Youth Programs)\",\n","    \"Health Service Delivery (Rural Health Units, Immunization, Maternal Care)\",\n","    \"Agricultural Support Services (Extension, Input Distribution, Market Access)\",\n","    \"Environmental Management (Waste Segregation, Tree Planting, Pollution Control)\",\n","    \"Citizen Engagement Mechanisms (Barangay Assemblies, Public Consultations)\",\n","    \"Digital Governance & E-Services (Online Permits, Digital Payments, Tech Literacy)\",\n","    \"Crisis & Pandemic Management (Contact Tracing, Vaccination, Relief Logistics)\",\n","    \"Gender and Development (GAD) (VAWC Desks, Women's Livelihood, Gender Budgeting)\",\n","    \"Local Economic Development (Cooperatives, Tourism, MSME Support)\",\n","    \"Fiscal Transparency & Accountability (Full Disclosure Policy, Budget Posting)\",\n","    \"Climate Change Adaptation (Flood Control, Resilience Planning, Coastal Management)\",\n","    \"Human Rights & Legal Aid (Barangay Human Rights Action Officers, Free Legal Clinics)\",\n","    \"Inter-LGU Collaboration (Metropolitan Arrangements, Shared Resource Agreements)\",\n","    \"Culture and Heritage Preservation (Local Museums, Historical Sites, Festivals)\",\n","    \"Internal Audit & COA Compliance (Audit Observations, Liquidation Processes)\"\n","]\n","\n","# FACTUAL ANCHOR POINTS - Real documented governance topics\n","FACTUAL_ANCHORS = {\n","    \"Historical Evolution\": [\n","        \"Pre-colonial barangay system\", \"Spanish-era gobernadorcillo\",\n","        \"American-era municipal organization\", \"Post-war Local Government Code\",\n","        \"1991 Local Government Code (RA 7160)\", \"Barangay Justice System (Katarungang Pambarangay)\",\n","        \"Sangguniang Kabataan establishment\", \"Barangay Health Workers system\"\n","    ],\n","    \"Structures & Positions\": [\n","        \"Barangay Captain (Punong Barangay)\", \"Sangguniang Barangay Members\",\n","        \"Barangay Secretary and Treasurer\", \"SK Chairperson and Councilors\",\n","        \"Barangay Tanod (Peace Officer)\", \"Lupon Tagapamayapa members\",\n","        \"Barangay Health Workers\", \"Day Care Workers\"\n","    ],\n","    \"Services & Processes\": [\n","        \"PSA/NSO birth certificate processing\", \"LTO driver's license application\",\n","        \"Business permit application at City Hall\", \"Building permit procedures\",\n","        \"Marriage license application\", \"Death certificate registration\",\n","        \"Barangay clearance requirements\", \"Community tax certificate (cedula)\"\n","    ],\n","    \"Programs & Initiatives\": [\n","        \"4Ps (Pantawid Pamilyang Pilipino Program)\", \"Senior Citizens' benefits\",\n","        \"Disaster Risk Reduction programs\", \"Solid Waste Management implementation\",\n","        \"Katarungang Pambarangay mediation\", \"Barangay nutrition programs\",\n","        \"Livelihood training programs\", \"Drug-clearing barangay initiatives\"\n","    ],\n","    \"Regional Variations\": [\n","        \"Cordillera Administrative Region autonomy\", \"Muslim Mindanao barangay structures\",\n","        \"Highly urbanized city barangays\", \"Island barangay governance challenges\",\n","        \"Metro Manila barangay operations\", \"Agricultural town barangay functions\"\n","    ],\n","    \"Digitalization & Tech\": [\n","        \"E-Governance Act compliance\", \"Integrated Business Permitting and Licensing System (iBPLS)\",\n","        \"PhilSys (National ID) integration\", \"Barangay Management Information Systems (BMIS)\",\n","        \"VaxCertPH verification\", \"Online appointment systems for PSA/LTO\"\n","    ],\n","    \"Specialized Governance Units\": [\n","        \"VAWC (Violence Against Women and their Children) Desk\",\n","        \"BCPC (Barangay Council for the Protection of Children)\",\n","        \"BADAC (Barangay Anti-Drug Abuse Council)\",\n","        \"BPOC (Barangay Peace and Order Committee)\",\n","        \"Barangay Development Council (BDC)\"\n","    ],\n","    \"Fiscal & Regulatory Tools\": [\n","        \"Full Disclosure Policy (FDP) Board\", \"Annual Investment Plan (AIP)\",\n","        \"Supplemental Budgeting process\", \"Seal of Good Local Governance (SGLG)\",\n","        \"Internal Revenue Allotment (now National Tax Allotment/NTA)\",\n","        \"Commission on Audit (COA) Circulars\"\n","    ],\n","    \"Emerging Sectoral Focus\": [\n","        \"Local Climate Change Action Plan (LCCAP)\", \"Zero Open Defecation (ZOD) programs\",\n","        \"TUPAD (Emergency Employment) coordination\", \"Solo Parents' Welfare Act implementation\",\n","        \"Feeding programs and Malnutrition intervention\"\n","    ]\n","}\n","\n","def load_existing_topics() -> List[str]:\n","    \"\"\"Load existing topics from multiple sources to exclude them.\"\"\"\n","    existing_topics = []\n","\n","    # 1. Load from current file (if any)\n","    if os.path.exists(TOPICS_FILE):\n","        try:\n","            with open(TOPICS_FILE, \"r\", encoding=\"utf-8\") as f:\n","                content = f.read()\n","                if content:\n","                    existing_topics.extend(json.loads(content))\n","                    print(f\"📁 Loaded {len(json.loads(content))} topics from current file\")\n","        except (json.JSONDecodeError, IOError) as e:\n","            print(f\"⚠️  Error loading current topics: {e}\")\n","\n","    # 2. Load from exclusion file (your existing topics)\n","    if os.path.exists(EXCLUSION_FILE):\n","        try:\n","            with open(EXCLUSION_FILE, \"r\", encoding=\"utf-8\") as f:\n","                content = f.read()\n","                if content:\n","                    excluded = json.loads(content)\n","                    existing_topics.extend(excluded)\n","                    print(f\"📁 Loaded {len(excluded)} topics from exclusion file\")\n","        except (json.JSONDecodeError, IOError) as e:\n","            print(f\"⚠️  Error loading exclusion topics: {e}\")\n","\n","    # Remove duplicates while preserving order\n","    seen = set()\n","    deduped = []\n","    for topic in existing_topics:\n","        if topic not in seen:\n","            seen.add(topic)\n","            deduped.append(topic)\n","\n","    print(f\"📚 Total existing topics (including exclusion): {len(deduped)}\")\n","    return deduped\n","\n","def save_topics(topics: List[str]):\n","    \"\"\"Save topics to JSON file.\"\"\"\n","    with open(TOPICS_FILE, \"w\", encoding=\"utf-8\") as f:\n","        json.dump(topics, f, indent=4, ensure_ascii=False)\n","\n","def extract_core_entities(topics: List[str]) -> Set[str]:\n","    \"\"\"Extract key entities/subjects from existing topics to avoid repetition.\"\"\"\n","    entities = set()\n","    common_words = {\"the\", \"of\", \"and\", \"in\", \"a\", \"an\", \"to\", \"from\", \"era\", \"period\",\n","                   \"government\", \"local\", \"barangay\", \"system\", \"process\", \"service\"}\n","\n","    for topic in topics:\n","        # Extract meaningful words (simple approach)\n","        words = topic.lower().replace(\":\", \" \").replace(\"-\", \" \").split()\n","        meaningful_words = [w for w in words if len(w) > 4 and w not in common_words]\n","        entities.update(meaningful_words[:3])  # First 3 meaningful words\n","\n","    return entities\n","\n","def create_anti_hallucination_prompt(\n","    count: int,\n","    lens: str,\n","    existing_topics: List[str],\n","    used_entities: Set[str],\n","    batch_number: int\n",") -> str:\n","    \"\"\"Create a prompt with strong anti-hallucination guardrails.\"\"\"\n","\n","    # Select random factual anchors from relevant categories\n","    anchor_examples = []\n","    for category, topics in FACTUAL_ANCHORS.items():\n","        anchor_examples.extend(random.sample(topics, min(2, len(topics))))\n","    random.shuffle(anchor_examples)\n","    anchor_str = \", \".join(anchor_examples[:8])\n","\n","    # Create exclusion context\n","    recent_topics = existing_topics[-50:] if len(existing_topics) > 50 else existing_topics\n","    exclusion_sample = json.dumps(recent_topics[:20], ensure_ascii=False)\n","\n","    overused_entities = \", \".join(list(used_entities)[:30])\n","\n","    prompt = f\"\"\"You are a Philippine public administration scholar with expertise in {lens}.\n","\n","**MISSION**: Generate {count} accurate, practical topics for Philippine local governance and public services research.\n","\n","**CRITICAL RULE - ZERO TOLERANCE FOR HALLUCINATION**:\n","- Every topic MUST reference real government structures, processes, or services\n","- Focus on actual laws, regulations, and procedures (RA 7160, LTO procedures, etc.)\n","- If you're uncertain about ANY detail, DO NOT include it\n","- Cross-reference mentally against known government processes before suggesting\n","- Examples of REAL governance elements you can build from: {anchor_str}\n","\n","**CURRENT THEMATIC LENS** (Batch #{batch_number}):\n","Focus Area: {lens}\n","\n","**BALANCE REQUIREMENTS**:\n","- 60% Governance structures and systems (barangay organization, local legislation)\n","- 40% Public services and citizen processes (licenses, certificates, permits)\n","- Include practical \"how-to\" aspects alongside theoretical governance analysis\n","\n","**STRUCTURAL REQUIREMENTS**:\n","1. Use format: \"The [Governance Aspect/Service]: [Specific Analytical or Practical Angle]\"\n","2. Include relevant laws or regulations when applicable (RA 7160, LTO regulations, etc.)\n","3. Mix these approaches:\n","   - Structural: government organization, positions, hierarchies\n","   - Processual: application procedures, bureaucratic workflows\n","   - Practical: citizen experiences, challenges, efficiencies\n","   - Comparative: urban vs rural, regional variations\n","   - Historical: evolution of systems over time\n","   - Reform-oriented: improvements, innovations, challenges\n","\n","**DIVERSITY REQUIREMENTS**:\n","- 30% Barangay-level governance (lowest administrative unit)\n","- 25% Municipal/City-level services and processes\n","- 20% Practical citizen experiences and bureaucracy navigation\n","- 15% Historical evolution and legal frameworks\n","- 10% Comparative regional variations and special cases\n","\n","**STRICT EXCLUSIONS**:\n","1. DO NOT repeat or create variations of these recent topics: {exclusion_sample}\n","2. MINIMIZE these overused entities: {overused_entities}\n","3. NEVER invent government positions, laws, or procedures that don't exist\n","4. AVOID purely theoretical topics without practical applications\n","5. DO NOT create fictional or hypothetical scenarios\n","\n","**VERIFICATION CHECKLIST** (mentally verify each before including):\n","□ Is this government structure/procedure/service documented in laws or official guidelines?\n","□ Can I name at least one relevant law, agency, or official process?\n","□ Is this distinct from the exclusion list?\n","□ Does this include practical aspects relevant to ordinary citizens?\n","□ Is this based on real Philippine government systems, not generic governance?\n","\n","**OUTPUT FORMAT**:\n","Return ONLY a valid JSON array of strings. Example:\n","[\n","  \"The Barangay Secretary Role: Document Management and Community Record-Keeping Challenges\",\n","  \"The Driver's License Application Process: Documentary Requirements and Practical Hurdles at LTO Offices\"\n","]\n","\n","Generate {count} topics now:\"\"\"\n","\n","    return prompt\n","\n","def validate_topics_for_hallucination(topics: List[str]) -> tuple[List[str], List[str]]:\n","    \"\"\"\n","    Basic validation to catch obvious hallucinations.\n","    Returns: (valid_topics, suspicious_topics)\n","    \"\"\"\n","    valid = []\n","    suspicious = []\n","\n","    # Updated red flags for governance topics\n","    red_flag_patterns = [\n","        \"Secret Police\", \"Hidden Courts\",  # Non-existent institutions\n","        \"Royal Decree\", \"Imperial Edict\",  # Inappropriate terminology\n","        \"Digital ID System\", \"National Database\",  # Non-existent systems\n","        \"Private Barangay\", \"Corporate Governance\",  # Misleading terms\n","        \"Federal System\", \"State Government\",  # Not applicable to Philippines\n","    ]\n","\n","    # List of real government agencies/terms for verification\n","    real_agencies = [\"LTO\", \"PSA\", \"NSO\", \"DILG\", \"DOH\", \"DSWD\", \"DENR\", \"DPWH\", \"DepEd\"]\n","\n","    for topic in topics:\n","        is_suspicious = any(flag.lower() in topic.lower() for flag in red_flag_patterns)\n","\n","        # Check for references to non-existent government structures\n","        suspicious_terms = [\"kingdom\", \"empire\", \"principality\", \"duchy\"]  # Inappropriate for PH\n","        if any(term in topic.lower() for term in suspicious_terms):\n","            is_suspicious = True\n","\n","        # Check if topic mentions real agencies incorrectly\n","        agency_mentioned = any(agency in topic for agency in real_agencies)\n","        if agency_mentioned and \"fictional\" in topic.lower():\n","            is_suspicious = True\n","\n","        # Additional check: topics that are too vague\n","        if len(topic) < 20 or topic.count(\" \") < 3:\n","            is_suspicious = True\n","\n","        if is_suspicious:\n","            suspicious.append(topic)\n","        else:\n","            valid.append(topic)\n","\n","    return valid, suspicious\n","\n","def check_similarity(new_topic: str, existing_topics: List[str], threshold: float = 0.6) -> bool:\n","    \"\"\"\n","    Simple similarity check using word overlap.\n","    Returns True if topic is too similar to existing ones.\n","    \"\"\"\n","    new_words = set(new_topic.lower().split())\n","\n","    for existing in existing_topics:\n","        existing_words = set(existing.lower().split())\n","\n","        # Jaccard similarity\n","        intersection = len(new_words & existing_words)\n","        union = len(new_words | existing_words)\n","\n","        if union > 0:\n","            similarity = intersection / union\n","            if similarity > threshold:\n","                return True\n","\n","    return False\n","\n","def generate_batch(\n","    batch_size: int,\n","    lens: str,\n","    existing_topics: List[str],\n","    used_entities: Set[str],\n","    batch_number: int\n",") -> List[str]:\n","    \"\"\"Generate a single batch of topics with validation.\"\"\"\n","\n","    prompt = create_anti_hallucination_prompt(\n","        count=batch_size,\n","        lens=lens,\n","        existing_topics=existing_topics,\n","        used_entities=used_entities,\n","        batch_number=batch_number\n","    )\n","\n","    # Call your LLM function here\n","    # Replace with your actual API call\n","    result = call_glm_with_retry(prompt, \"Governance Expert\", temperature=0.7)\n","\n","    if not result:\n","        return []\n","\n","    try:\n","        new_topics = json.loads(clean_json_output(result))\n","\n","        # Validate for hallucinations\n","        valid_topics, suspicious_topics = validate_topics_for_hallucination(new_topics)\n","\n","        if suspicious_topics:\n","            print(f\"⚠️  Filtered {len(suspicious_topics)} suspicious topics: {suspicious_topics[:3]}\")\n","\n","        # Deduplicate against existing\n","        unique_topics = []\n","        for topic in valid_topics:\n","            if topic not in existing_topics and not check_similarity(topic, existing_topics):\n","                unique_topics.append(topic)\n","\n","        return unique_topics\n","\n","    except Exception as e:\n","        print(f\"❌ Error parsing batch: {e}\")\n","        return []\n","\n","def create_backup(filepath: str):\n","    \"\"\"Create timestamped backup of a file.\"\"\"\n","    import shutil\n","    from datetime import datetime\n","\n","    if not os.path.exists(BACKUP_DIR):\n","        os.makedirs(BACKUP_DIR)\n","\n","    if os.path.exists(filepath):\n","        timestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n","        filename = os.path.basename(filepath)\n","        backup_path = os.path.join(BACKUP_DIR, f\"{timestamp}_{filename}\")\n","        shutil.copy2(filepath, backup_path)\n","        print(f\"💾 Created backup: {backup_path}\")\n","\n","def combine_and_create_master():\n","    \"\"\"\n","    Combine topics from exclusion file and newly generated file into a master file.\n","    Also creates backups of original files.\n","    \"\"\"\n","    from datetime import datetime\n","\n","    print(f\"\\n{'='*70}\")\n","    print(f\"🔄 Combining topics into master file...\")\n","    print(f\"{'='*70}\")\n","\n","    # Create backups first\n","    if os.path.exists(EXCLUSION_FILE):\n","        create_backup(EXCLUSION_FILE)\n","\n","    if os.path.exists(TOPICS_FILE):\n","        create_backup(TOPICS_FILE)\n","\n","    # Load all topics from both sources\n","    all_topics = []\n","    sources = []\n","\n","    # Load from exclusion file (existing topics)\n","    if os.path.exists(EXCLUSION_FILE):\n","        try:\n","            with open(EXCLUSION_FILE, \"r\", encoding=\"utf-8\") as f:\n","                excluded_topics = json.load(f)\n","                all_topics.extend(excluded_topics)\n","                sources.append((EXCLUSION_FILE, len(excluded_topics)))\n","                print(f\"📁 Added {len(excluded_topics)} topics from {EXCLUSION_FILE}\")\n","        except Exception as e:\n","            print(f\"⚠️  Error loading {EXCLUSION_FILE}: {e}\")\n","\n","    # Load from newly generated topics\n","    if os.path.exists(TOPICS_FILE):\n","        try:\n","            with open(TOPICS_FILE, \"r\", encoding=\"utf-8\") as f:\n","                new_topics = json.load(f)\n","                all_topics.extend(new_topics)\n","                sources.append((TOPICS_FILE, len(new_topics)))\n","                print(f\"📁 Added {len(new_topics)} topics from {TOPICS_FILE}\")\n","        except Exception as e:\n","            print(f\"⚠️  Error loading {TOPICS_FILE}: {e}\")\n","\n","    # Remove duplicates while preserving order of first appearance\n","    seen = set()\n","    unique_topics = []\n","    duplicates_count = 0\n","\n","    for topic in all_topics:\n","        if topic not in seen:\n","            seen.add(topic)\n","            unique_topics.append(topic)\n","        else:\n","            duplicates_count += 1\n","\n","    # Sort topics alphabetically for better organization (optional)\n","    unique_topics.sort()\n","\n","    # Save to master file\n","    try:\n","        with open(MASTER_FILE, \"w\", encoding=\"utf-8\") as f:\n","            json.dump(unique_topics, f, indent=4, ensure_ascii=False)\n","\n","        print(f\"\\n✅ Master file created: {MASTER_FILE}\")\n","        print(f\"📊 Summary:\")\n","        print(f\"   Total topics from all sources: {len(all_topics)}\")\n","        print(f\"   Duplicates removed: {duplicates_count}\")\n","        print(f\"   Unique topics in master file: {len(unique_topics)}\")\n","        print(f\"   Sources combined: {[f'{name} ({count})' for name, count in sources]}\")\n","\n","        # Create metadata about the merge\n","        metadata = {\n","            \"merge_date\": datetime.now().isoformat(),\n","            \"source_files\": [name for name, _ in sources],\n","            \"source_counts\": {name: count for name, count in sources},\n","            \"total_before_deduplication\": len(all_topics),\n","            \"duplicates_removed\": duplicates_count,\n","            \"total_after_deduplication\": len(unique_topics)\n","        }\n","\n","        metadata_file = MASTER_FILE.replace(\".json\", \"_metadata.json\")\n","        with open(metadata_file, \"w\", encoding=\"utf-8\") as f:\n","            json.dump(metadata, f, indent=4, ensure_ascii=False)\n","\n","        print(f\"📋 Metadata saved to: {metadata_file}\")\n","\n","        return unique_topics\n","\n","    except Exception as e:\n","        print(f\"❌ Error creating master file: {e}\")\n","        return []\n","\n","def analyze_topic_overlap():\n","    \"\"\"Analyze overlap between exclusion file and newly generated topics.\"\"\"\n","    if not os.path.exists(EXCLUSION_FILE) or not os.path.exists(TOPICS_FILE):\n","        print(\"❌ Both files must exist for analysis\")\n","        return\n","\n","    with open(EXCLUSION_FILE, \"r\", encoding=\"utf-8\") as f:\n","        excluded_topics = set(json.load(f))\n","\n","    with open(TOPICS_FILE, \"r\", encoding=\"utf-8\") as f:\n","        new_topics = set(json.load(f))\n","\n","    overlap = excluded_topics.intersection(new_topics)\n","\n","    print(f\"\\n{'='*70}\")\n","    print(f\"📊 TOPIC OVERLAP ANALYSIS\")\n","    print(f\"{'='*70}\")\n","    print(f\"Exclusion file topics: {len(excluded_topics)}\")\n","    print(f\"New topics: {len(